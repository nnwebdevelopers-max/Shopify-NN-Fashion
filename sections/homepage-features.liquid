{%- comment -%}
  ============================================================================
  Section: Homepage features (icon + text strip)
  ----------------------------------------------------------------------------
  Row of short store promises under the slideshow:

    [↻] RETURN & EXCHANGE  │ [✓] QUALITY GUARANTEE │ [▭] FREE DELIVERY │ [☎] +1(800)…
        You can return…    │     No MOQ…           │     Free delivery…│     Round the…

  Each item is a block: icon (built-in or uploaded image), title, text and
  an optional link. Columns = number of items (desktop); 2 columns or 1 on mobile.

  Used in:   templates/index.json ("features")
  CSS:       assets/homepage.css → "2. Features" (classes .features*)
  JS:        none
  Editable:  Theme editor > Home page > Features
  ============================================================================
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  {%- comment -%}
    Wrapper. Colors, icon size, padding and column count come from settings
    as CSS custom properties.
  {%- endcomment -%}
  <div
    class="features{% if section.settings.show_dividers %} features--dividers{% endif %} features--mobile-{{ section.settings.mobile_columns }}"
    style="
      --features-bg: {{ section.settings.background_color }};
      --features-text: {{ section.settings.text_color }};
      --features-icon: {{ section.settings.icon_color }};
      --features-icon-size: {{ section.settings.icon_size }}px;
      --features-columns: {{ section.blocks.size }};
      --features-padding-top: {{ section.settings.padding_top }}px;
      --features-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="page-width">
      <ul class="features__list" role="list">
        {%- for block in section.blocks -%}
          <li class="features__item" {{ block.shopify_attributes }}>
            {%- comment -%} Icon: uploaded image wins over the built-in icon; "none" hides it {%- endcomment -%}
            {%- if block.settings.custom_icon != blank -%}
              <span class="features__icon">
                {{ block.settings.custom_icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', class: 'features__icon-image' }}
              </span>
            {%- elsif block.settings.icon != 'none' -%}
              <span class="features__icon">
                {% render 'global-icon', name: block.settings.icon, size: section.settings.icon_size %}
              </span>
            {%- endif -%}

            <div class="features__content">
              {%- comment -%} Title is a link when a link is set (e.g. tel: for the phone item) {%- endcomment -%}
              {%- if block.settings.title != blank -%}
                <p class="features__title">
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
                  {%- else -%}
                    {{ block.settings.title | escape }}
                  {%- endif -%}
                </p>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <p class="features__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{%- comment -%}
  Schema (theme editor settings) — JSON cannot contain comments, so they live here.
  - enabled_on.templates: ["index"] → home page only.
  Settings:
  - Layout:  show_dividers, mobile_columns (1 / 2), padding_top, padding_bottom
  - Icons:   icon_size (20–48 px), icon_color
  - Colors:  background_color, text_color
  Blocks (max 6):
  - feature → icon (built-in list or none), custom_icon (image), title, text, link
{%- endcomment -%}
{% schema %}
{
  "name": "Features",
  "tag": "div",
  "class": "section-homepage-features",
  "enabled_on": {
    "templates": ["index"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show dividers between items",
      "default": true
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "return", "label": "Return / exchange" },
            { "value": "shield", "label": "Shield / guarantee" },
            { "value": "box", "label": "Box / delivery" },
            { "value": "truck", "label": "Truck / shipping" },
            { "value": "phone", "label": "Phone" },
            { "value": "chat", "label": "Chat / support" },
            { "value": "lock", "label": "Lock / secure payment" },
            { "value": "star", "label": "Star / quality" },
            { "value": "heart", "label": "Heart" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "return"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Optional. Replaces the icon above. Square image, at least 96 × 96 px."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Return & exchange"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "You can return or exchange the item within 30 days."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Makes the title a link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features",
      "blocks": [
        { "type": "feature", "settings": { "icon": "return", "title": "Return & exchange", "text": "You can return or exchange the item within 30 days." } },
        { "type": "feature", "settings": { "icon": "shield", "title": "100% quality guarantee", "text": "No MOQ, customize production acceptable." } },
        { "type": "feature", "settings": { "icon": "box", "title": "Free delivery", "text": "Free delivery on orders of $200 and more." } },
        { "type": "feature", "settings": { "icon": "phone", "title": "+1(800) 2345 6789", "text": "Round the clock free hotline one-to-one." } }
      ]
    }
  ]
}
{% endschema %}
