{%- comment -%}
  ============================================================================
  Section: About stack (stacking cards, About page)
  ----------------------------------------------------------------------------
      ┌──────────────────┐ ┌───────────────────────┐
      │ WHAT WE STAND FOR│ │ 🤝            01      │ ← card 1 (shrinks, dims)
      │ Four things we   │ │┌──────────────────────┐│
      │ never compromise ││ │ 🧵           02      ││ ← card 2 slides over it
      │ on (stays put)   ││ │ Built to last        ││
      └──────────────────┘ └┴──────────────────────┘┘
  Animated (GSAP, assets/global-scroll-animations.js → initStack): the cards stick near the top
  one after another, each new card sliding over the previous one; the
  cards underneath shrink, tilt back slightly and darken. The heading on
  the left stays in view (CSS sticky).
  Static: a simple list of cards.

  Used in:   templates/page.about.json
  CSS:       assets/about.css → "5. Stacking cards" (.about-stack*)
  JS:        assets/global-scroll-animations.js → initStack()
  ============================================================================
{%- endcomment -%}

<section
  class="about about-stack{% if section.settings.serif %} about--serif{% endif %}"
  data-about="stack"
  style="--about-bg: {{ section.settings.background_color }}; --about-text: {{ section.settings.text_color }}; --about-accent: {{ section.settings.accent_color }};"
>
  <div class="about__inner about-stack__grid">
    <div class="about-stack__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="about__eyebrow" data-fade>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="about__heading" data-split>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="about__text" data-fade>{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="about-stack__cards">
      {%- for block in section.blocks -%}
        <article
          class="about-stack__card"
          style="--i: {{ forloop.index0 }}; --card-bg: {{ block.settings.card_color }}; --card-text: {{ block.settings.card_text_color }};"
          data-stack-card
          {{ block.shopify_attributes }}
        >
          <div class="about-stack__top">
            <span class="about-stack__icon" aria-hidden="true">{{ block.settings.icon | escape }}</span>
            <span class="about-stack__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          </div>
          <h3 class="about-stack__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="about-stack__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%}
  Schema — settings: eyebrow, heading, text, serif, colors
  blocks: card (icon emoji, title, text, card color, card text color)
{%- endcomment -%}
{% schema %}
{
  "name": "About: stacking cards",
  "tag": "div",
  "class": "section-about-stack",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "What we stand for" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four things we never compromise on" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Style" },
    { "type": "checkbox", "id": "serif", "label": "Serif headings", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F6F3EC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2F3A2F" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B8734F" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✦" },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Tell shoppers what this stands for." },
        { "type": "color", "id": "card_color", "label": "Card color", "default": "#2F3A2F" },
        { "type": "color", "id": "card_text_color", "label": "Card text color", "default": "#F6F3EC" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About: stacking cards",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
