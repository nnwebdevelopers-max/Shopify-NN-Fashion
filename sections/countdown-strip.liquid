{%- liquid
  assign scheme = settings.body_scheme.id
  if section.settings.custom_scheme
    assign scheme = section.settings.color_scheme.id
  endif
-%}
<div class="cdstrip color-scheme color-{{ scheme }}" data-countdown="{{ section.settings.end_date | escape }}" data-hours="{{ section.settings.fallback_hours }}">
  <div class="wrap in">
    <div class="t">{{ section.settings.title | escape }}</div>
    <div class="cd">{{ section.settings.label | escape }}&nbsp; <b data-cd-out>00 : 00 : 00</b></div>
    <div class="r">{%- if section.settings.button != blank -%}<a class="btn primary" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.button | escape }}</a>{%- endif -%}</div>
  </div>
</div>

{% schema %}
{
  "name": "Countdown strip",
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "text", "id": "title", "label": "Title", "default": "Lorem ipsum sale" },
    { "type": "text", "id": "label", "label": "Countdown label", "default": "Offer ends in" },
    { "type": "text", "id": "end_date", "label": "End date and time", "info": "Format: 2026-12-31 23:59. Leave empty to loop a daily countdown." },
    { "type": "range", "id": "fallback_hours", "label": "Loop length when no date is set", "min": 1, "max": 72, "step": 1, "unit": "h", "default": 24 },
    { "type": "text", "id": "button", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [ { "name": "Countdown strip" } ]
}
{% endschema %}
