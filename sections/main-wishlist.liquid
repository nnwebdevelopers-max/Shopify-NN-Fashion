<div class="color-scheme color-{% if section.settings.custom_scheme %}{{ section.settings.color_scheme.id }}{% else %}{{ settings.body_scheme.id }}{% endif %}" data-list-page="wishlist">
  <div class="wrap">
    {%- if section.settings.show_breadcrumbs -%}{% render 'breadcrumbs', last: page.title %}{%- endif -%}
    <div class="phead">
      {%- if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
      <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
      {%- if page.content != blank %}<div class="rte">{{ page.content }}</div>{% endif -%}
    </div>

    <div class="list-loading" data-list-loading>{{ 'general.loading' | t }}</div>
    <div class="grid" data-wishlist-grid data-tint-mode="{{ settings.card_tint }}" style="--cols:{{ section.settings.columns }}"></div>

    <div class="list-empty" data-list-empty hidden>
      <span class="list-empty-icon">{% render 'icon', icon: 'heart' %}</span>
      <h2>{{ section.settings.empty_heading | escape }}</h2>
      {%- if section.settings.empty_text != blank %}<div class="rte">{{ section.settings.empty_text }}</div>{% endif -%}
      <a class="btn primary" href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}">{{ section.settings.empty_button | escape }}</a>
    </div>
  </div>
  <div style="height:{{ section.settings.padding_bottom }}px"></div>
</div>

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "info": "Off: this section follows the default color scheme in Theme settings > Colors.", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Saved for later" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the page title." },
    { "type": "range", "id": "columns", "label": "Products per row on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "header", "content": "Empty wishlist" },
    { "type": "text", "id": "empty_heading", "label": "Heading", "default": "Your wishlist is empty" },
    { "type": "richtext", "id": "empty_text", "label": "Text", "default": "<p>Tap the heart on any product to save it here. Lorem ipsum dolor sit amet.</p>" },
    { "type": "text", "id": "empty_button", "label": "Button label", "default": "Start shopping" },
    { "type": "url", "id": "empty_link", "label": "Button link" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ]
}
{% endschema %}
