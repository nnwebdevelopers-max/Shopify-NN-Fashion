{%- liquid
  assign scheme = settings.body_scheme.id
  if section.settings.custom_scheme
    assign scheme = section.settings.color_scheme.id
  endif
-%}
<div class="sec color-scheme color-{{ scheme }}" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="wrap">
    <div class="head rv">
      <div>
        {%- if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
        {%- if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif -%}
      </div>
    </div>
    <div class="look" data-stagger>
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- assign c = block.settings.collection -%}
        <a class="lk {{ block.settings.shape }}" href="{{ p.url | default: c.url | default: block.settings.link | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          <div class="lkimg tint-{{ forloop.index0 | modulo: 4 | plus: 1 }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- elsif p != blank and p.featured_media -%}
              {{ p.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', alt: p.title }}
            {%- elsif c != blank and c.image -%}
              {{ c.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: c.title }}
            {%- else -%}
              <div class="lkart">{% render 'art', name: block.settings.art %}</div>
            {%- endif -%}
          </div>
          <div class="lktx"><b>{{ block.settings.title | default: p.title | default: c.title | escape }}</b>{% if p != blank %}<span>{{ p.price | money }}</span>{% endif %}</div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lookbook grid",
  "max_blocks": 12,
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Autumn / Winter" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The <em>lookbook</em>" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "select", "id": "shape", "label": "Shape", "options": [ { "value": "tall", "label": "Tall" }, { "value": "square", "label": "Square" }, { "value": "arch", "label": "Arch" } ], "default": "tall" },
        { "type": "product", "id": "product", "label": "Product", "info": "Uses the product image and links to it." },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Used when no product is chosen." },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "art", "label": "Illustration (when no image)", "default": "jacket", "options": [ { "value": "jacket", "label": "Jacket" }, { "value": "coat", "label": "Coat" }, { "value": "dress", "label": "Dress" }, { "value": "sneaker", "label": "Sneaker" }, { "value": "backpack", "label": "Backpack" } ] }
      ]
    }
  ],
  "presets": [ { "name": "Lookbook grid", "blocks": [ { "type": "look" }, { "type": "look", "settings": { "shape": "arch" } }, { "type": "look", "settings": { "shape": "square" } } ] } ]
}
{% endschema %}
