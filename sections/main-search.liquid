{%- paginate search.results by 24 -%}
<div class="color-scheme color-{% if section.settings.custom_scheme %}{{ section.settings.color_scheme.id }}{% else %}{{ settings.body_scheme.id }}{% endif %}">
  <div class="wrap">
    {%- assign search_label = 'search.title' | t -%}
    {% render 'breadcrumbs', last: search_label %}
    <div class="sphead">
      <p class="eyebrow">{{ 'search.eyebrow' | t }}</p>
      <h1>{% if search.performed %}{{ 'search.results_for' | t: count: search.results_count, terms: search.terms }}{% else %}{{ 'search.title' | t }}{% endif %}</h1>
      <form class="sform" action="{{ routes.search_url }}" method="get" role="search">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.placeholder' | t }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button class="btn primary" type="submit">{{ 'search.submit' | t }}</button>
      </form>
    </div>
    {%- if search.performed -%}
      {%- assign products = search.results | where: 'object_type', 'product' -%}
      {%- assign others = search.results | where: 'object_type', 'article' -%}
      {%- assign pages_found = search.results | where: 'object_type', 'page' -%}
      <h2 class="sec-t">{{ 'search.products' | t }} ({{ products.size }})</h2>
      {%- if products.size > 0 -%}
        <div class="grid">{% for p in products %}{% render 'product-card', product: p, index: forloop.index0 %}{% endfor %}</div>
      {%- else -%}
        <p class="rte">{{ 'search.no_products' | t }}</p>
      {%- endif -%}
      {%- assign pages_and_articles = others | concat: pages_found -%}
      <h2 class="sec-t">{{ 'search.articles' | t }} ({{ pages_and_articles.size }})</h2>
      {%- if pages_and_articles.size > 0 -%}
        <div class="alist">
          {%- for x in pages_and_articles -%}
            <a href="{{ x.url }}">
              <div class="th tint-{{ forloop.index0 | modulo: 4 | plus: 1 }}" style="width:84px;height:64px;border-radius:12px;display:grid;place-items:center;flex:none;overflow:hidden">
                {%- if x.image -%}{{ x.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', style: 'width:100%;height:100%;object-fit:cover' }}{%- else -%}<span style="width:50%;height:80%;display:block">{% render 'art', name: 'laptop' %}</span>{%- endif -%}
              </div>
              <div><span class="tag">{% if x.object_type == 'article' %}{{ 'search.article' | t }}{% else %}{{ 'search.page' | t }}{% endif %}</span><div><b>{{ x.title | escape }}</b></div></div>
            </a>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="rte" style="margin-bottom:60px">{{ 'search.no_articles' | t }}</p>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination: previous: '←', next: '→' }}</nav>
      {%- endif -%}
    {%- endif -%}
  </div>
  <div style="height:100px"></div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search results",
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "info": "Off: this section follows the default color scheme in Theme settings > Colors.", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" }
  ]
}
{% endschema %}
