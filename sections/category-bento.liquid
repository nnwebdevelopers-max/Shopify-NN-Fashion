<div class="sec color-scheme color-{% if section.settings.custom_scheme %}{{ section.settings.color_scheme.id }}{% else %}{{ settings.body_scheme.id }}{% endif %}" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="wrap rv">
    <div class="head">
      <div>
        {%- if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
        {%- if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif -%}
      </div>
      {%- if section.settings.link_label != blank %}<a class="link" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.link_label | escape }}</a>{% endif -%}
    </div>
    <div class="bento">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- capture title -%}{%- if block.settings.title != blank -%}{{ block.settings.title }}{%- elsif c != blank -%}{{ c.title }}{%- else -%}{{ 'collections.placeholder' | t }}{%- endif -%}{%- endcapture -%}
        <a class="cat tint-{{ block.settings.tint }} {{ block.settings.size }}" href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.collections_url }}{% endif %}" {{ block.shopify_attributes }}>
          <div class="tx">
            <h3>{{ title | escape }}</h3>
            {%- if block.settings.text != blank -%}<small>{{ block.settings.text | escape }}</small>
            {%- elsif c != blank -%}<small>{{ 'collections.product_count' | t: count: c.products_count }}</small>{%- endif -%}
          </div>
          <span class="go" aria-hidden="true">→</span>
          <div class="art">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}
            {%- elsif block.settings.art == 'collection' and c != blank -%}
              {% render 'collection-art', collection: c, width: 600 %}
            {%- elsif block.settings.art == 'collection' -%}
              {% render 'art', name: 'jacket' %}
            {%- else -%}
              {% render 'art', name: block.settings.art %}
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category tiles",
  "max_blocks": 12,
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "info": "Off: this section follows the default color scheme in Theme settings > Colors.", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lorem ipsum" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dolor sit amet elit." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Lorem ipsum dolor" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
        { "type": "text", "id": "text", "label": "Subtitle", "info": "Defaults to the product count." },
        {
          "type": "select", "id": "size", "label": "Tile size",
          "options": [ { "value": "", "label": "Small" }, { "value": "wide", "label": "Wide" }, { "value": "big", "label": "Large" } ],
          "default": ""
        },
        {
          "type": "select", "id": "tint", "label": "Tint",
          "options": [ { "value": "1", "label": "Tint 1" }, { "value": "2", "label": "Tint 2" }, { "value": "3", "label": "Tint 3" }, { "value": "4", "label": "Tint 4" }, { "value": "surface", "label": "Surface" } ],
          "default": "1"
        },
        {
          "type": "select", "id": "art", "label": "Illustration",
          "options": [
            { "value": "collection", "label": "From collection" },
            { "value": "jacket", "label": "Jacket" }, { "value": "coat", "label": "Coat" }, { "value": "hoodie", "label": "Hoodie" },
            { "value": "sweater", "label": "Sweater" }, { "value": "tee", "label": "Tee" }, { "value": "dress", "label": "Dress" }, { "value": "jeans", "label": "Jeans" },
            { "value": "sneaker", "label": "Sneaker" }, { "value": "boot", "label": "Boot" }, { "value": "backpack", "label": "Backpack" }, { "value": "cap", "label": "Cap" },
            { "value": "scarf", "label": "Scarf" }, { "value": "belt", "label": "Belt" }, { "value": "sunglasses", "label": "Sunglasses" }
          ],
          "default": "collection"
        },
        { "type": "image_picker", "id": "image", "label": "Custom image", "info": "Recommended: 900 × 900 px (square). Overrides the illustration." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "category", "settings": { "size": "big", "tint": "1", "art": "jacket" } },
        { "type": "category", "settings": { "size": "wide", "tint": "2", "art": "laptop" } },
        { "type": "category", "settings": { "tint": "3", "art": "hoodie" } },
        { "type": "category", "settings": { "tint": "4", "art": "watch" } }
      ]
    }
  ]
}
{% endschema %}
