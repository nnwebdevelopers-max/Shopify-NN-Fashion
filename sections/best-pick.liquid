{%- liquid
  assign scheme = settings.body_scheme.id
  if section.settings.custom_scheme
    assign scheme = section.settings.color_scheme.id
  endif
  assign p = section.settings.product
-%}
<section class="sec color-scheme color-{{ scheme }}" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="wrap">
    <div class="mhead rv">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    </div>
    {%- if p != blank -%}
      <div class="bpick">
        <div class="bgal">
          {%- for media in p.media limit: 4 -%}
            <a class="bg{% if forloop.first %} bg-lg{% endif %}" href="{{ p.url }}">{{ media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 900px) 30vw, 90vw', alt: media.alt | default: p.title }}</a>
          {%- endfor -%}
        </div>
        <aside class="binfo">
          {%- if p.compare_at_price > p.price -%}<span class="badge sale">{{ 'products.sale' | t }}</span>{%- endif -%}
          <h3><a href="{{ p.url }}">{{ p.title | escape }}</a></h3>
          <div class="bprice">{% render 'price', product: p %}</div>
          <div class="rte">{{ p.description | strip_html | truncatewords: 34 }}</div>
          {%- if p.available -%}
            <form method="post" action="{{ routes.cart_add_url }}" data-cart-form>
              {%- if p.has_only_default_variant -%}
                <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="btn primary full atc"><span class="atc-label">{{ 'products.add_to_cart' | t }}</span></button>
              {%- else -%}
                <a class="btn primary full" href="{{ p.url }}" data-quick-view="{{ p.url }}" aria-haspopup="dialog">{{ 'products.choose_options' | t }}</a>
              {%- endif -%}
            </form>
          {%- endif -%}
          <a class="link" href="{{ p.url }}">{{ section.settings.view_label | escape }}</a>
        </aside>
      </div>
    {%- elsif request.design_mode -%}
      <p class="rte">Pick a product in this section's settings.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Best pick",
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lorem ipsum" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our best pick" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "view_label", "label": "Link label", "default": "View full details" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [ { "name": "Best pick" } ]
}
{% endschema %}
