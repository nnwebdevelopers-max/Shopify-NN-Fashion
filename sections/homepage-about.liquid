{%- comment -%}
  ============================================================================
  Section: Homepage about
  ----------------------------------------------------------------------------
  Image beside a text column:

    ┌──────────────────┐  ABOUT US                     ← label (accent color)
    │                  │  Unlock your style potential  ← heading
    │      image       │  Welcome to our store…        ← text (rich text)
    │                  │  [ READ MORE ]                ← button
    └──────────────────┘

  Image left or right (setting). Phones: image on top, text below.

  Used in:   templates/index.json ("about")
  CSS:       assets/homepage.css → "7. About" (classes .about*)
  JS:        none
  Editable:  Theme editor > Home page > About
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign image = section.settings.image
  assign focal_point = image.presentation.focal_point | default: 'center'
  assign image_style = 'object-position: ' | append: focal_point
-%}

{%- comment -%}
  Wrapper. Modifiers: about--image-<left|right>, about--ratio-<ratio>.
  Colors and padding come from settings as CSS custom properties.
{%- endcomment -%}
<div
  class="about about--image-{{ section.settings.image_position }} about--ratio-{{ section.settings.image_ratio }}"
  style="
    --about-bg: {{ section.settings.background_color }};
    --about-text: {{ section.settings.text_color }};
    --about-accent: {{ section.settings.accent_color }};
    --about-padding-top: {{ section.settings.padding_top }}px;
    --about-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width about__inner">
    {%- comment -%} ---------- Image ---------- {%- endcomment -%}
    <div class="about__media">
      {%- if image != blank -%}
        {{ image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 600px, 100vw', class: 'about__image', style: image_style }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'about__image about__placeholder' }}
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Text (each part hidden when empty) ---------- {%- endcomment -%}
    <div class="about__content">
      {%- if section.settings.label != blank -%}
        <p class="about__label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="about__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        {%- comment -%} Rich text output already includes <p> tags {%- endcomment -%}
        <div class="about__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="button about__button">
          {{- section.settings.button_label | escape -}}
          {% render 'global-icon', name: 'arrow-right', size: 16 %}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%}
  Schema (theme editor settings) — JSON cannot contain comments, so they live here.
  - enabled_on.templates: ["index"] → home page only.
  Settings:
  - Image:    image, image_position (left / right), image_ratio
              (landscape / square / portrait / original)
  - Text:     label (small accent text), heading, text (rich text),
              button_label, button_link
  - Colors:   background_color, text_color, accent_color (label + button)
  - Spacing:  padding_top, padding_bottom
{%- endcomment -%}
{% schema %}
{
  "name": "About",
  "tag": "section",
  "class": "section-homepage-about",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "landscape", "label": "Landscape (16:9)" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "original", "label": "Original" }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "About us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Unlock your style potential"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Welcome to our store — the ideal destination to enhance your style. Tell your customers about your brand, your story and what makes your products special.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Read more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "The button is hidden until a link is set."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fafafa"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "info": "Label and button.",
      "default": "#c8102e"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "About"
    }
  ]
}
{% endschema %}
