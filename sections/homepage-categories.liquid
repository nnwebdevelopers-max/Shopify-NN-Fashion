{%- comment -%}
  ============================================================================
  Section: Homepage categories (collection cards)
  ----------------------------------------------------------------------------
  Row of image cards linking to collections, title over the bottom of each:

    ┌──────┐┌──────┐┌──────┐┌──────┐┌──────┐┌──────┐
    │ img  ││ img  ││ img  ││ img  ││ img  ││ img  │
    │TITLE ││TITLE ││TITLE ││TITLE ││TITLE ││TITLE │
    └──────┘└──────┘└──────┘└──────┘└──────┘└──────┘

  Each card is a block: pick a collection; title and image come from the
  collection unless a custom title/image is set on the block.
  Responsive: N per row on large screens, max 6 on small laptops; below
  990px a swipeable row or a grid (3 per row on tablets, 2 or 3 on phones).

  Used in:   templates/index.json ("categories")
  CSS:       assets/homepage.css → "3. Categories" (classes .categories*)
  JS:        none (mobile swipe row is CSS scroll-snap)
  Text:      locales → homepage.categories.* (fallback label/title)
  Editable:  Theme editor > Home page > Categories
  ============================================================================
{%- endcomment -%}

{%- liquid
  # Card image aspect ratio for CSS
  case section.settings.image_ratio
    when 'square'
      assign card_ratio = '1 / 1'
    when 'landscape'
      assign card_ratio = '4 / 3'
    else
      assign card_ratio = '4 / 5'
  endcase

  # Cards per row: the setting on large screens, at most 6 on small laptops
  # (990–1199px) so cards don't get too small. Smaller screens: see homepage.css.
  assign cols = section.settings.columns_desktop
  assign cols_small = cols
  if cols_small > 6
    assign cols_small = 6
  endif

  # "sizes" for the images, based on the desktop column count
  assign image_sizes = '(min-width: 1200px) calc(1200px / ' | append: cols | append: '), (min-width: 990px) calc(100vw / ' | append: cols_small | append: '), (min-width: 750px) 220px, 42vw'

  # Screen-reader name for the section: the heading, or the translated default
  if section.settings.heading != blank
    assign section_label = section.settings.heading
  else
    assign section_label = 'homepage.categories.label' | t
  endif
-%}

{%- if section.blocks.size > 0 -%}
  {%- comment -%}
    Wrapper. Colors, columns, ratio, radius and padding come from settings
    as CSS custom properties. Modifier: categories--mobile-<grid-2|grid-3|scroll>.
  {%- endcomment -%}
  <section
    class="categories categories--mobile-{{ section.settings.mobile_layout }}{% if section.settings.show_gradient %} categories--gradient{% endif %}"
    style="
      --categories-bg: {{ section.settings.background_color }};
      --categories-text: {{ section.settings.text_color }};
      --categories-columns: {{ cols }};
      --categories-columns-small: {{ cols_small }};
      --categories-ratio: {{ card_ratio }};
      --categories-radius: {{ section.settings.corner_radius }}px;
      --categories-padding-top: {{ section.settings.padding_top }}px;
      --categories-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
    aria-label="{{ section_label | escape }}"
  >
    <div class="page-width">
      {%- comment -%} Optional heading above the cards {%- endcomment -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="categories__heading categories__heading--{{ section.settings.heading_alignment }}">
          {{- section.settings.heading | escape -}}
        </h2>
      {%- endif -%}

      <ul class="categories__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign category = block.settings.collection

            # Title: custom title → collection title → placeholder (editor preview)
            if block.settings.title != blank
              assign card_title = block.settings.title
            elsif category != blank
              assign card_title = category.title
            else
              assign card_title = 'homepage.categories.placeholder_title' | t
            endif

            # Image: custom image → collection image
            assign card_image = block.settings.image
            if card_image == blank and category != blank
              assign card_image = category.featured_image
            endif

            # Link: collection page, or "All products" when no collection is chosen yet
            if category != blank
              assign card_url = category.url
            else
              assign card_url = routes.all_products_collection_url
            endif
          -%}
          <li class="categories__item" {{ block.shopify_attributes }}>
            <a href="{{ card_url }}" class="categories__card">
              <span class="categories__media">
                {%- if card_image != blank -%}
                  {{ card_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 300, 400, 600', sizes: image_sizes, alt: '', class: 'categories__image' }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'categories__image categories__placeholder' }}
                {%- endif -%}
              </span>
              {%- comment -%} The title doubles as the link text, so the image alt is empty {%- endcomment -%}
              <span class="categories__title">{{ card_title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{%- comment -%}
  Schema (theme editor settings) — JSON cannot contain comments, so they live here.
  - enabled_on.templates: ["index"] → home page only.
  Settings:
  - Heading:  heading (optional), heading_alignment
  - Layout:   columns_desktop (3–8), mobile_layout (3 columns (default) /
              2 columns / swipeable row), padding_top, padding_bottom
  - Cards:    image_ratio (portrait 4:5 / square / landscape), corner_radius,
              show_gradient (dark fade behind titles)
  - Colors:   background_color, text_color
  Blocks (max 12):
  - category → collection, title (optional override), image (optional override)
{%- endcomment -%}
{% schema %}
{
  "name": "Categories",
  "tag": "div",
  "class": "section-homepage-categories",
  "enabled_on": {
    "templates": ["index"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave empty to hide."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards per row on desktop",
      "info": "Small laptops show at most 6.",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "info": "Tablets and phones. With columns, tablets show 3 per row.",
      "options": [
        { "value": "grid-3", "label": "3 columns (all categories visible)" },
        { "value": "grid-2", "label": "2 columns (all categories visible)" },
        { "value": "scroll", "label": "Swipeable row (some hidden until swiped)" }
      ],
      "default": "grid-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_gradient",
      "label": "Dark fade behind titles",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Optional. Leave empty to use the collection title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Leave empty to use the collection image."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
