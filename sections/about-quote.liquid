{%- comment -%}
  ============================================================================
  Section: About quote (scroll-filled quote, About page)
  ----------------------------------------------------------------------------
                             “                    ← big mark (turns + grows)
          We'd rather you buy one piece you love
            ░░░░░ ░░ ░░░░░ ░░░░░░ ░░░ ░░░░░░        ← words fill in as you scroll
                     OUR PROMISE TO YOU
  Animated (GSAP, assets/global-scroll-animations.js → initQuote): the words go from faint to
  solid one by one, tied to the scroll position (scrubbed both ways); the
  quote mark grows and turns; the caption fades up.

  Used in:   templates/page.about.json
  CSS:       assets/about.css → "7. Scroll-filled quote" (.about-quote*)
  JS:        assets/global-scroll-animations.js → initQuote()
  ============================================================================
{%- endcomment -%}

<section
  class="about about-quote{% if section.settings.serif %} about--serif{% endif %}"
  data-about="quote"
  style="--about-bg: {{ section.settings.background_color }}; --about-text: {{ section.settings.text_color }}; --about-accent: {{ section.settings.accent_color }};"
>
  <div class="about__inner">
    <span class="about-quote__mark" aria-hidden="true" data-quote-mark>“</span>
    <blockquote class="about-quote__text" data-fill>{{ section.settings.quote | escape }}</blockquote>
    {%- if section.settings.caption != blank -%}
      <p class="about-quote__caption" data-fade>{{ section.settings.caption | escape }}</p>
    {%- endif -%}
  </div>
</section>

{%- comment -%} Schema — settings: quote, caption, serif, colors {%- endcomment -%}
{% schema %}
{
  "name": "About: quote",
  "tag": "div",
  "class": "section-about-quote",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "We'd rather you buy one piece you love for years than five you forget by next month." },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Our promise to you" },
    { "type": "checkbox", "id": "serif", "label": "Serif text", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#E9E2D3" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2F3A2F" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B8734F" }
  ],
  "presets": [{ "name": "About: quote" }]
}
{% endschema %}
