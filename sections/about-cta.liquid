{%- comment -%}
  ============================================================================
  Section: About CTA (call to action, About page)
  ----------------------------------------------------------------------------
      ┌──────────────────────────────────────────┐
      │        (background photo, dimmed)         │
      │          Find your new favourite          │
      │     Browse the full collection, or …      │
      │   [ SHOP THE COLLECTION ]  [ CONTACT US ] │
      └──────────────────────────────────────────┘
  Animated (GSAP, assets/global-scroll-animations.js → initCta): the background photo zooms out
  as the section scrolls into view; heading words rise in; text and
  buttons fade up; buttons follow the mouse a little ("magnetic").
  Without an image: plain background color.

  Used in:   templates/page.about.json
  CSS:       assets/about.css → "8. Call to action" (.about-cta*)
  JS:        assets/global-scroll-animations.js → initCta()
  ============================================================================
{%- endcomment -%}

{%- assign cta_dim = section.settings.image_dim | divided_by: 100.0 -%}

<section
  class="about about-cta{% if section.settings.image != blank %} about-cta--image{% endif %}{% if section.settings.serif %} about--serif{% endif %}"
  data-about="cta"
  style="--about-bg: {{ section.settings.background_color }}; --about-text: {{ section.settings.text_color }}; --about-accent: {{ section.settings.accent_color }}; --cta-dim: {{ cta_dim }};"
>
  {%- if section.settings.image != blank -%}
    <div class="about-cta__bg" data-cta-bg>
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1200, 1800, 2400', sizes: '100vw', alt: '' }}
    </div>
  {%- endif -%}

  <div class="about-cta__content">
    <h2 class="about__heading" data-split>{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="about__text" data-fade>{{ section.settings.text }}</div>
    {%- endif -%}
    <div class="about-cta__buttons" data-fade>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--lg about-button about-button--solid" data-magnetic>
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a href="{{ section.settings.button_2_link | default: routes.root_url }}" class="button button--lg about-button" data-magnetic>
          {{- section.settings.button_2_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%}
  Schema — settings: heading, text, image + image_dim, two buttons, serif, colors
{%- endcomment -%}
{% schema %}
{
  "name": "About: call to action",
  "tag": "div",
  "class": "section-about-cta",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your new favourite" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Browse the full collection, or get in touch. We read every message and are always happy to help with sizing and styling.</p>" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "image_dim", "label": "Image dimming", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 50 },
    { "type": "text", "id": "button_label", "label": "Button 1 label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button 1 link", "info": "Leave empty for All products." },
    { "type": "text", "id": "button_2_label", "label": "Button 2 label", "default": "Contact us" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" },
    { "type": "header", "content": "Style" },
    { "type": "checkbox", "id": "serif", "label": "Serif heading", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F6F3EC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2F3A2F" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B8734F" }
  ],
  "presets": [{ "name": "About: call to action" }]
}
{% endschema %}
