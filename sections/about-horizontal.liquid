{%- comment -%}
  ============================================================================
  Section: About horizontal (horizontal-scroll gallery, About page)
  ----------------------------------------------------------------------------
      ┌──────────────────────────────────────────────────────────────┐
      │ THE COLLECTION      ┌──────┐  ┌──────┐  ┌──────┐  ┌──────┐   │ ──→
      │ Everything you      │ img  │  │ img  │  │ img  │  │ img  │   │
      │ need…  [Shop →]     └──────┘  └──────┘  └──────┘  └──────┘   │
      │                     Essentials  Layers   Touches             │
      │                        ━━━━━━━━━━──────────  progress         │
      └──────────────────────────────────────────────────────────────┘
  Animated (GSAP, assets/global-scroll-animations.js → initHorizontal; desktop/tablet): the
  section pins to the screen and scrolling down moves the row of cards
  sideways; photos drift inside their frames (parallax) and a progress bar
  fills. Phones / static: a row you swipe sideways.

  Used in:   templates/page.about.json
  CSS:       assets/about.css → "6. Horizontal gallery" (.about-hscroll*)
  JS:        assets/global-scroll-animations.js → initHorizontal()
  ============================================================================
{%- endcomment -%}

<section
  class="about about-hscroll{% if section.settings.serif %} about--serif{% endif %}"
  data-about="horizontal"
  style="--about-bg: {{ section.settings.background_color }}; --about-text: {{ section.settings.text_color }}; --about-accent: {{ section.settings.accent_color }};"
>
  <div class="about-hscroll__track" data-h-track>
    <div class="about-hscroll__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="about__eyebrow" data-fade>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="about__heading" data-split>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="about__text" data-fade>{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div data-fade>
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--lg about-button">
            {{- section.settings.button_label | escape -}}
            {% render 'global-icon', name: 'arrow-right', size: 18 %}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- liquid
        assign card_tag = 'div'
        if block.settings.link != blank
          assign card_tag = 'a'
        endif
      -%}
      <{{ card_tag }}
        class="about-hscroll__card"
        {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
        data-h-card
        {{ block.shopify_attributes }}
      >
        <div class="about-hscroll__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '(min-width: 750px) 32vw, 78vw', alt: block.settings.image.alt }}
          {%- else -%}
            {{ 'collection-apparel-1' | placeholder_svg_tag: 'about__placeholder' }}
          {%- endif -%}
        </div>
        <h3 class="about-hscroll__title">{{ block.settings.title | escape }}</h3>
        {%- if block.settings.text != blank -%}
          <p class="about-hscroll__text">{{ block.settings.text | escape }}</p>
        {%- endif -%}
      </{{ card_tag }}>
    {%- endfor -%}
  </div>

  <div class="about-hscroll__progress" aria-hidden="true"><span data-h-progress></span></div>
</section>

{%- comment -%}
  Schema — settings: eyebrow, heading, text, button label/link, serif, colors
  blocks: card (image, title, text, link)
{%- endcomment -%}
{% schema %}
{
  "name": "About: horizontal gallery",
  "tag": "div",
  "class": "section-about-horizontal",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you need, nothing you don't" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty for All products." },
    { "type": "header", "content": "Style" },
    { "type": "checkbox", "id": "serif", "label": "Serif headings", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F6F3EC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2F3A2F" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B8734F" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About: horizontal gallery",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
