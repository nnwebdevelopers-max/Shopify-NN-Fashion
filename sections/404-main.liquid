{%- comment -%}
  ============================================================================
  Section: 404 main ("Page not found")
  ----------------------------------------------------------------------------
                               404               ← big outlined number
                        PAGE NOT FOUND
        The page you're looking for doesn't exist or has moved…
              [ Search products…            🔍 ]
              [ BACK TO HOME ]  [ SHOP ALL PRODUCTS ]

  Shown by Shopify for any address that doesn't exist (instead of its
  plain gray "Not Found" box). The search box sends shoppers to the search
  results page.

  Used in:   templates/404.json ("main")
  CSS:       assets/404.css (classes .not-found*)
  JS:        — None
  Text:      locales → not_found.*, search.placeholder / search.submit;
             heading and text can be overridden in the editor
  Editable:  Theme editor > 404 page
  ============================================================================
{%- endcomment -%}

{%- liquid
  if section.settings.heading != blank
    assign heading = section.settings.heading | escape
  else
    assign heading = 'not_found.title' | t
  endif
  if section.settings.text != blank
    assign body_text = section.settings.text | escape
  else
    assign body_text = 'not_found.text' | t
  endif
  assign shop_url = section.settings.shop_link | default: routes.all_products_collection_url
-%}

<section class="page-width not-found">
  <p class="not-found__code" aria-hidden="true">{{ 'not_found.code' | t }}</p>
  <h1 class="not-found__title">{{ heading }}</h1>
  <p class="not-found__text">{{ body_text }}</p>

  {%- comment -%} Search: plain GET form to the search page {%- endcomment -%}
  {%- if section.settings.show_search -%}
    <form action="{{ routes.search_url }}" method="get" role="search" class="not-found__search">
      <label for="NotFoundSearch" class="visually-hidden">{{ 'not_found.search_label' | t }}</label>
      <input
        type="search"
        id="NotFoundSearch"
        name="q"
        class="not-found__input"
        placeholder="{{ 'search.placeholder' | t }}"
        autocomplete="off"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="not-found__search-button" aria-label="{{ 'search.submit' | t }}">
        {% render 'global-icon', name: 'search', size: 20 %}
      </button>
    </form>
  {%- endif -%}

  <div class="not-found__actions">
    <a href="{{ routes.root_url }}" class="button button--primary not-found__button" data-magnetic>
      {%- render 'global-icon', name: 'arrow-left', size: 16 -%}
      {{ 'not_found.home' | t }}
    </a>
    <a href="{{ shop_url }}" class="button button--outline not-found__button">
      {{- 'not_found.shop' | t -}}
      {% render 'global-icon', name: 'arrow-right', size: 16 %}
    </a>
  </div>
</section>

{%- comment -%}
  Schema (theme editor settings) — JSON cannot contain comments, so they live here.
  - enabled_on.templates: ["404"]
  Settings: heading / text (empty → translated defaults), show_search,
            shop_link (second button; empty → All products)
{%- endcomment -%}
{% schema %}
{
  "name": "Page not found",
  "tag": "div",
  "class": "section-404-main",
  "enabled_on": {
    "templates": ["404"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the translated default (\"Page not found\")."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "info": "Leave empty to use the translated default."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search box",
      "default": true
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "\"Shop all products\" link",
      "info": "Leave empty for All products."
    }
  ],
  "presets": [
    {
      "name": "Page not found"
    }
  ]
}
{% endschema %}
