{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = product.collections.first
  endif
-%}
{%- if source != blank and source.products_count > 1 -%}
<div class="sec color-scheme color-{% if section.settings.custom_scheme %}{{ section.settings.color_scheme.id }}{% else %}{{ settings.body_scheme.id }}{% endif %}" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="wrap rv">
    <div class="head">
      <div>
        {%- if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
        {%- if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif -%}
      </div>
    </div>
    <div class="grid">
      {%- assign shown = 0 -%}
      {%- for p in source.products -%}
        {%- if p.id != product.id and shown < section.settings.limit -%}
          {% render 'product-card', product: p, index: shown %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "info": "Off: this section follows the default color scheme in Theme settings > Colors.", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lorem ipsum" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dolor sit amet." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to the product's first collection." },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Related products" } ]
}
{% endschema %}
