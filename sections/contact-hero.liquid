{%- comment -%}
  ============================================================================
  Section: Contact hero (Contact page)
  ----------------------------------------------------------------------------
      GET IN TOUCH
      Let's talk.                       We're here to help with orders,
      ═══════════                       sizing and anything in between.
                                        [✉ hello@…]  [☎ +1 …]
      ┌─────────────────────────────────────────────────────────┐
      │                 wide photo (rounded)                     │
      └─────────────────────────────────────────────────────────┘
  Animated (GSAP, assets/global-scroll-animations.js → initContactHero):
  - the giant heading's words rise in on load, text and chips follow
  - the photo grows from a rounded, inset card to the full width as it
    scrolls into view, zooming out inside (scrubbed with the scroll)
  Static (no JS / reduced motion): the same layout, no motion.
  Quick-contact chips: the store email (Shopify admin > Settings > Store
  details) and phone (Theme settings > Contact) unless typed here.

  Content from the page editor (Online Store > Pages > Contact): the page
  fields (metafields) contact.hero_eyebrow, contact.hero_heading,
  contact.hero_text, contact.hero_image, contact.email, contact.phone
  win when filled; empty ones fall back to this section's settings.
  (Definitions to create: README → "Contact page" → "Page fields".)

  Used in:   templates/page.contact.json
  CSS:       assets/contact.css → "2. Hero" (.contact-hero*)
  JS:        assets/global-scroll-animations.js → initContactHero()
  ============================================================================
{%- endcomment -%}

{%- liquid
  # Page fields first, then the theme editor settings
  assign mf = page.metafields.contact
  assign hero_eyebrow = mf.hero_eyebrow.value | default: section.settings.eyebrow
  assign hero_heading = mf.hero_heading.value | default: section.settings.heading
  assign hero_image = mf.hero_image.value | default: section.settings.image
  if mf.hero_text.value != blank
    assign hero_text = mf.hero_text.value | escape | newline_to_br | prepend: '<p>' | append: '</p>'
  else
    assign hero_text = section.settings.text
  endif

  assign hero_email = mf.email.value | default: section.settings.email | default: shop.email
  assign hero_phone = mf.phone.value | default: section.settings.phone | default: settings.contact_phone
  assign phone_digits = hero_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
-%}

<section
  class="contact contact-hero{% if section.settings.serif %} contact--serif{% endif %}"
  data-scroll-fx="contact-hero"
  style="--contact-bg: {{ section.settings.background_color }}; --contact-text: {{ section.settings.text_color }}; --contact-accent: {{ section.settings.accent_color }};"
>
  <div class="contact__inner contact-hero__top">
    <div>
      {%- if hero_eyebrow != blank -%}
        <p class="contact__eyebrow" data-fade>{{ hero_eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="contact-hero__title" data-split>{{ hero_heading | escape }}</h1>
    </div>
    <div class="contact-hero__side">
      {%- if hero_text != blank -%}
        <div class="contact__text" data-fade>{{ hero_text }}</div>
      {%- endif -%}
      <div class="contact-hero__chips" data-fade>
        {%- if section.settings.show_email and hero_email != blank -%}
          <a href="mailto:{{ hero_email }}" class="contact-chip">
            {% render 'global-icon', name: 'mail', size: 18 %}
            <span>{{ hero_email | escape }}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.show_phone and hero_phone != blank -%}
          <a href="tel:{{ phone_digits }}" class="contact-chip">
            {% render 'global-icon', name: 'phone', size: 18 %}
            <span>{{ hero_phone | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if hero_image != blank -%}
    <div class="contact-hero__media" data-grow-media>
      {{
        hero_image
        | image_url: width: 2400
        | image_tag: widths: '750, 1200, 1800, 2400', sizes: '100vw', loading: 'eager', alt: hero_image.alt
      }}
    </div>
  {%- endif -%}
</section>

{%- comment -%}
  Schema — settings: eyebrow, heading, text, show_email + email, show_phone +
  phone (empty → store email / Theme settings > Contact phone), image, serif,
  background / text / accent colors
{%- endcomment -%}
{% schema %}
{
  "name": "Contact: hero",
  "tag": "div",
  "class": "section-contact-hero",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "paragraph", "content": "Texts, image, email and phone can also be edited in Online Store > Pages > Contact (page fields contact.*). Filled page fields replace the values below." },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let's talk." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We're here to help with orders, sizing, styling and anything in between.</p>" },
    { "type": "checkbox", "id": "show_email", "label": "Show email button", "default": true },
    { "type": "text", "id": "email", "label": "Email", "info": "Leave empty to use the store email." },
    { "type": "checkbox", "id": "show_phone", "label": "Show phone button", "default": true },
    { "type": "text", "id": "phone", "label": "Phone", "info": "Leave empty to use Theme settings > Contact." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Grows to full width while scrolling. 2400 × 1000 px recommended." },
    { "type": "header", "content": "Style" },
    { "type": "checkbox", "id": "serif", "label": "Serif heading", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F6F3EC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2F3A2F" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B8734F" }
  ],
  "presets": [{ "name": "Contact: hero" }]
}
{% endschema %}
