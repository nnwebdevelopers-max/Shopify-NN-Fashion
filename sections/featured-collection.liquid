{%- assign limit = section.settings.limit -%}
<div class="sec color-scheme color-{% if section.settings.custom_scheme %}{{ section.settings.color_scheme.id }}{% else %}{{ settings.body_scheme.id }}{% endif %}" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="wrap rv" data-tabs>
    <div class="head">
      <div>
        {%- if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
        {%- if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="tabs" role="tablist">
          {%- for block in section.blocks -%}
            <button type="button" class="tab" role="tab" data-tab="{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {% unless forloop.first %}tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>
              {{- block.settings.label | default: block.settings.collection.title | default: 'Lorem' | escape -}}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      <div class="tabpanel" role="tabpanel" data-tabpanel="{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
        <div class="grid" style="--cols:{{ section.settings.columns }}">
          {%- if c != blank and c.products_count > 0 -%}
            {%- for product in c.products limit: limit -%}
              {% render 'product-card', product: product, index: forloop.index0 %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <article class="card"><div class="ph tint-{{ i }}"><span class="pimg" style="display:block">{% case i %}{% when 1 %}{% render 'art', name: 'jacket' %}{% when 2 %}{% render 'art', name: 'hoodie' %}{% when 3 %}{% render 'art', name: 'sneaker' %}{% else %}{% render 'art', name: 'backpack' %}{% endcase %}</span></div><div><h3>{{ 'products.placeholder' | t }}</h3><div class="meta"><span class="price">$99.00</span></div></div></article>
            {%- endfor -%}
          {%- endif -%}
        </div>
        {%- if section.settings.show_view_all and c != blank and c.products_count > limit -%}
          <div class="view-all"><a class="btn ghost" href="{{ c.url }}">{{ 'general.view_all' | t }} <span class="arr">→</span></a></div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured products",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "info": "Off: this section follows the default color scheme in Theme settings > Colors.", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lorem ipsum" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dolor sit amet." },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show “View all” button", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab label", "info": "Defaults to the collection title." }
      ]
    }
  ],
  "presets": [
    { "name": "Featured products", "blocks": [ { "type": "tab" } ] }
  ]
}
{% endschema %}
