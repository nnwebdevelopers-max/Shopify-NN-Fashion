{%- comment -%}
  ============================================================================
  Section: Cart main (cart page)
  ----------------------------------------------------------------------------
      YOUR CART
      ┌─────────────────────────────────────────────┐  ┌───────────────────┐
      │ [img] Twill Overshirt      $79.00  [−1+] ✕  │  │ 🏷 Discount code ⌄│
      │       Olive / M                     $79.00  │  │ 🚚 Est. shipping ⌄│
      │ [img] Linen Resort Shirt   $54.95  [−1+] ✕  │  │ ✎ Add order note ⌄│
      │                                     $54.95  │  │ Subtotal  $158.00 │
      └─────────────────────────────────────────────┘  │ Taxes… at checkout│
                                                       │ [  CHECK OUT   ]  │
                                                       └───────────────────┘

  - Rendered by Liquid from the real cart, so it works without JavaScript
    (a normal form: "Update cart" button + remove links).
  - With JavaScript (assets/cart.js): quantity − / + / typed value and
    remove apply instantly via /cart/change.js, the section is re-rendered
    with the Section Rendering API (?section_id=…), the header cart count
    and total refresh, and the order note saves while typing.
  - Line discounts, cart discounts, selling plans and custom properties
    (e.g. engraving text) are shown when present.
  - Bulk delete (JS only): a checkbox on each item, "Select all" and
    "Delete selected (n)" under the list; the button is disabled while
    nothing is checked.
  - Summary panels (snippets/cart-tools.liquid): discount code, shipping
    estimate, order note. shopify_common.js (Shopify's script) provides
    the country → state list for the shipping estimate.
  - Empty cart → message + "Continue shopping" button.

  Used in:   templates/cart.json ("main")
  CSS:       assets/cart.css (classes .cart*)
  JS:        assets/cart.js (+ window.NNCards from global-product-card.js)
  Text:      locales → cart.*
  Editable:  Theme editor > Cart
  ============================================================================
{%- endcomment -%}

{%- liquid
  if section.settings.heading != blank
    assign heading = section.settings.heading
  else
    assign heading = 'cart.title' | t
  endif
  assign continue_url = section.settings.continue_link | default: routes.all_products_collection_url
-%}

{%- comment -%}
  Wrapper. data-section-id is used by cart.js to fetch this section's
  updated HTML; data-cart-section marks the part that gets replaced.
{%- endcomment -%}
{%- comment -%} Shopify's helper for the shipping estimate's country → state list (Shopify.CountryProvinceSelector) {%- endcomment -%}
{%- if section.settings.show_shipping_estimate -%}
  <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>
{%- endif -%}

<section class="page-width cart" data-cart data-section-id="{{ section.id }}">
  <div data-cart-section>
    <h1 class="cart__title">{{ heading | escape }}</h1>

    {%- if cart.item_count > 0 -%}
      {%- comment -%} Normal form: works without JS (Update cart / Check out buttons) {%- endcomment -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="cart__layout" novalidate>
        {%- comment -%} ---------- Items ---------- {%- endcomment -%}
        <div class="cart__items">
          {%- comment -%} Column titles (desktop) {%- endcomment -%}
          <div class="cart__row cart__row--head" aria-hidden="true">
            <span>{{ 'cart.product' | t }}</span>
            <span>{{ 'cart.quantity' | t }}</span>
            <span class="cart__head-total">{{ 'cart.total' | t }}</span>
          </div>

          <ul class="cart__list" role="list">
            {%- for item in cart.items -%}
              {%- comment -%} data-line = 1-based line number used by /cart/change.js {%- endcomment -%}
              <li class="cart__row cart__item" data-cart-line="{{ forloop.index }}" data-cart-key="{{ item.key }}">
                {%- comment -%} Checkbox (bulk delete) + image + product details {%- endcomment -%}
                <div class="cart__product">
                  {%- comment -%}
                    Select for "Delete selected" (JS only, hidden without it).
                    No name: never sent with the cart form.
                  {%- endcomment -%}
                  <label class="cart__select">
                    <input type="checkbox" class="cart__select-input" data-cart-select>
                    <span class="cart__select-box" aria-hidden="true">{% render 'global-icon', name: 'check', size: 14 %}</span>
                    <span class="visually-hidden">{{ 'cart.select_item' | t: product: item.product.title }}</span>
                  </label>
                  <a href="{{ item.url }}" class="cart__image-link" tabindex="-1" aria-hidden="true">
                    {%- if item.image -%}
                      {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '120px', alt: '', class: 'cart__image' }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'cart__image cart__placeholder' }}
                    {%- endif -%}
                  </a>

                  <div class="cart__details">
                    <a href="{{ item.url }}" class="cart__product-title">{{ item.product.title | escape }}</a>

                    {%- comment -%} Variant options, e.g. "Color: Olive", "Size: M" {%- endcomment -%}
                    {%- unless item.product.has_only_default_variant -%}
                      <ul class="cart__options" role="list">
                        {%- for option in item.options_with_values -%}
                          <li>{{ option.name | escape }}: {{ option.value | escape }}</li>
                        {%- endfor -%}
                      </ul>
                    {%- endunless -%}

                    {%- comment -%} Subscription plan name (if sold with a selling plan) {%- endcomment -%}
                    {%- if item.selling_plan_allocation -%}
                      <p class="cart__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                    {%- endif -%}

                    {%- comment -%} Custom line item properties (keys starting with "_" are hidden) {%- endcomment -%}
                    {%- for property in item.properties -%}
                      {%- assign first_character = property.first | slice: 0 -%}
                      {%- if property.last != blank and first_character != '_' -%}
                        <p class="cart__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
                      {%- endif -%}
                    {%- endfor -%}

                    {%- comment -%} Unit price (with original price when discounted) {%- endcomment -%}
                    <p class="cart__unit-price">
                      {%- if item.original_price > item.final_price -%}
                        <s>{{ item.original_price | money }}</s>
                      {%- endif -%}
                      {{ item.final_price | money }}
                    </p>

                    {%- comment -%} Line discounts, e.g. "SUMMER10 (−$5.00)" {%- endcomment -%}
                    {%- for discount in item.line_level_discount_allocations -%}
                      <p class="cart__discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>
                    {%- endfor -%}
                  </div>
                </div>

                {%- comment -%} Quantity stepper + remove {%- endcomment -%}
                <div class="cart__quantity">
                  <div class="cart__stepper">
                    <button type="button" class="cart__step" data-cart-step="-1" aria-label="{{ 'cart.decrease' | t: product: item.product.title }}">−</button>
                    <input
                      class="cart__qty-input"
                      type="number"
                      name="updates[]"
                      id="CartQty-{{ forloop.index }}"
                      value="{{ item.quantity }}"
                      min="0"
                      inputmode="numeric"
                      aria-label="{{ 'cart.quantity' | t }}: {{ item.product.title | escape }}"
                      data-cart-qty
                    >
                    <button type="button" class="cart__step" data-cart-step="1" aria-label="{{ 'cart.increase' | t: product: item.product.title }}">+</button>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="cart__remove" data-cart-remove aria-label="{{ 'cart.remove' | t: product: item.product.title }}">
                    {% render 'global-icon', name: 'trash', size: 18 %}
                  </a>
                </div>

                {%- comment -%} Line total {%- endcomment -%}
                <div class="cart__line-total">
                  {%- if item.original_line_price > item.final_line_price -%}
                    <s>{{ item.original_line_price | money }}</s>
                  {%- endif -%}
                  <span>{{ item.final_line_price | money }}</span>
                </div>
              </li>
            {%- endfor -%}
          </ul>

          {%- comment -%}
            ---------- Bulk actions (JS only) ----------
            [☐ Select all]                       [🗑 DELETE SELECTED (2)]
            The button is disabled until an item is checked; cart.js removes
            every checked line in one /cart/update.js request.
          {%- endcomment -%}
          <div class="cart__bulk">
            <label class="cart__select cart__select--all">
              <input type="checkbox" class="cart__select-input" data-cart-select-all>
              <span class="cart__select-box" aria-hidden="true">{% render 'global-icon', name: 'check', size: 14 %}</span>
              <span>{{ 'cart.select_all' | t }}</span>
            </label>
            <button
              type="button"
              class="button button--primary button--sm cart__bulk-delete"
              data-cart-delete-selected
              data-text-label="{{ 'cart.delete_selected' | t }}"
              data-text-label-count="{{ 'cart.delete_selected_count' | t: number: '[number]' }}"
              disabled
            >
              {% render 'global-icon', name: 'trash', size: 16 %}
              <span data-cart-delete-label>{{ 'cart.delete_selected' | t }}</span>
            </button>
          </div>

          {%- comment -%} Without JS only (cart.js hides it): applies typed quantities {%- endcomment -%}
          <button type="submit" name="update" class="button cart__update" data-cart-update>{{ 'cart.update' | t }}</button>
          <a href="{{ continue_url }}" class="button button--link cart__continue">
            {%- render 'global-icon', name: 'arrow-left', size: 14 -%}
            {{ 'cart.continue_shopping' | t }}
          </a>
        </div>

        {%- comment -%} ---------- Summary ---------- {%- endcomment -%}
        <aside class="cart__summary">
          {%- comment -%} Discount code / Estimate shipping / Add order note panels {%- endcomment -%}
          {%- if section.settings.show_discount or section.settings.show_shipping_estimate or section.settings.show_note -%}
            {% render 'cart-tools',
              show_discount: section.settings.show_discount,
              show_shipping: section.settings.show_shipping_estimate,
              show_note: section.settings.show_note
            %}
          {%- endif -%}

          {%- comment -%} Cart-level discounts (e.g. order discount codes) {%- endcomment -%}
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <div class="cart__summary-row">
              <span>{{ 'cart.discounts' | t }}</span>
              <ul class="cart__summary-discounts" role="list">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li>{{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="cart__summary-row cart__summary-row--total">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span class="cart__subtotal">{{ cart.total_price | money_with_currency }}</span>
          </div>

          <p class="cart__taxes">{{ 'cart.taxes_note' | t }}</p>

          {%- comment -%} Goes to Shopify checkout (name="checkout" submits the form there) {%- endcomment -%}
          <button type="submit" name="checkout" class="button button--primary button--lg button--full cart__checkout" data-magnetic>
            {% render 'global-icon', name: 'lock', size: 18 %}
            {{ 'cart.checkout' | t }}
          </button>

          {%- comment -%} Express checkout buttons (Shop Pay, PayPal…), if enabled in settings {%- endcomment -%}
          {%- if section.settings.show_express_checkout and additional_checkout_buttons -%}
            <div class="cart__express">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}

          {%- comment -%} Errors from cart.js (e.g. not enough stock) {%- endcomment -%}
          <p class="cart__error" role="alert" data-cart-error hidden></p>
        </aside>
      </form>
    {%- else -%}
      {%- comment -%} ---------- Empty cart ---------- {%- endcomment -%}
      <div class="cart__empty">
        <span class="cart__empty-icon" aria-hidden="true">{% render 'global-icon', name: 'cart', size: 44 %}</span>
        <h2 class="cart__empty-title">{{ 'cart.empty_title' | t }}</h2>
        <p>{{ 'cart.empty_text' | t }}</p>
        <a href="{{ continue_url }}" class="button cart__empty-button">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Loading text for screen readers while cart.js updates the cart {%- endcomment -%}
  <p class="visually-hidden" aria-live="polite" data-cart-status data-text-updating="{{ 'cart.updating' | t }}" data-text-error="{{ 'cart.error' | t }}"></p>
</section>

{%- comment -%}
  Schema (theme editor settings) — JSON cannot contain comments, so they live here.
  - enabled_on.templates: ["cart"] → only on the cart page.
  Settings: heading (empty → translated "Your cart"); Cart tools:
            show_discount, show_shipping_estimate, show_note (panels in
            snippets/cart-tools.liquid); show_express_checkout (Shop Pay /
            PayPal… buttons when available), continue_link (empty → All products)
{%- endcomment -%}
{% schema %}
{
  "name": "Cart",
  "tag": "div",
  "class": "section-cart-main",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the translated default (\"Your cart\")."
    },
    {
      "type": "header",
      "content": "Cart tools"
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "Show discount code field",
      "info": "Create codes in Shopify admin > Discounts.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping_estimate",
      "label": "Show shipping estimate",
      "info": "Rates come from Settings > Shipping and delivery.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show \"Add order note\"",
      "default": true
    },
    {
      "type": "header",
      "content": "Checkout"
    },
    {
      "type": "checkbox",
      "id": "show_express_checkout",
      "label": "Show express checkout buttons",
      "info": "Shop Pay, PayPal, Apple Pay… when enabled in Settings > Payments.",
      "default": true
    },
    {
      "type": "url",
      "id": "continue_link",
      "label": "\"Continue shopping\" link",
      "info": "Leave empty for All products."
    }
  ],
  "presets": [
    {
      "name": "Cart"
    }
  ]
}
{% endschema %}
