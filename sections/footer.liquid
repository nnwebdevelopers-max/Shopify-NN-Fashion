{%- assign menus = section.blocks | where: 'type', 'menu' -%}
<footer class="site color-scheme color-{% if section.settings.custom_scheme %}{{ section.settings.color_scheme.id }}{% else %}{{ settings.body_scheme.id }}{% endif %}">
  <div class="wrap">
    <div class="fgrid" style="--n:{{ menus.size | at_least: 1 }}">
      <div>
        <a class="logo" href="{{ routes.root_url }}">
          {%- if settings.logo != blank -%}{{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy' }}{%- else -%}<i></i>{{ shop.name | escape }}{%- endif -%}
        </a>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
        {%- if section.settings.show_social -%}
          <div class="socials">
            {%- if settings.social_instagram != blank %}<a href="{{ settings.social_instagram }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', icon: 'instagram' %}</a>{% endif -%}
            {%- if settings.social_facebook != blank %}<a href="{{ settings.social_facebook }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', icon: 'facebook' %}</a>{% endif -%}
            {%- if settings.social_x != blank %}<a href="{{ settings.social_x }}" aria-label="X" rel="noopener" target="_blank">{% render 'icon', icon: 'x' %}</a>{% endif -%}
            {%- if settings.social_youtube != blank %}<a href="{{ settings.social_youtube }}" aria-label="YouTube" rel="noopener" target="_blank">{% render 'icon', icon: 'youtube' %}</a>{% endif -%}
            {%- if settings.social_tiktok != blank %}<a href="{{ settings.social_tiktok }}" aria-label="TikTok" rel="noopener" target="_blank">{% render 'icon', icon: 'tiktok' %}</a>{% endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- for block in menus -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading | default: block.settings.menu.title | escape }}</h4>
          {%- for link in block.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="legal">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}{% if section.settings.legal != blank %} · {{ section.settings.legal | escape }}{% endif %}</span>
      {%- if section.settings.show_policies -%}
        <span>{% for policy in shop.policies %}{% unless forloop.first %} · {% endunless %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endfor %}</span>
      {%- endif -%}
      {%- if section.settings.show_payment -%}
        <span class="pay">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</span>
      {%- endif -%}
    </div>
  </div>
  <div class="fmark" aria-hidden="true">{{ shop.name | escape }}</div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 5,
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "info": "Off: this section follows the default color scheme in Theme settings > Colors.", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "text", "id": "text", "label": "Brand text", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit." },
    { "type": "text", "id": "legal", "label": "Legal line", "default": "Lorem ipsum dolor sit amet" },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "info": "Links are set in Theme settings > Social media.", "default": true },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links", "default": false },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": false }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
