<div class="sec color-scheme color-{% if section.settings.custom_scheme %}{{ section.settings.color_scheme.id }}{% else %}{{ settings.body_scheme.id }}{% endif %}" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="wrap">
    <div class="prose" style="font-size:16px">
      {%- if section.settings.heading != blank -%}<h2 style="margin-top:0">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- form 'contact', class: 'cform' -%}
        {%- if form.posted_successfully? -%}
          <p class="notice" role="status">{{ 'contact.success' | t }}</p>
        {%- elsif form.errors -%}
          <div class="notice err" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="two">
          <label class="field">{{ 'contact.name' | t }}<input type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"></label>
          <label class="field">{{ 'contact.email' | t }} *<input type="email" name="contact[email]" required autocomplete="email" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"></label>
        </div>
        <label class="field">{{ 'contact.phone' | t }}<input type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></label>
        <label class="field">{{ 'contact.message' | t }}<textarea name="contact[body]">{{ form.body }}</textarea></label>
        <div><button type="submit" class="btn primary">{{ 'contact.send' | t }} <span class="arr">→</span></button></div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "info": "Off: this section follows the default color scheme in Theme settings > Colors.", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lorem ipsum dolor" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}
