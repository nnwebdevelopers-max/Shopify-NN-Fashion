{%- liquid
  assign scheme = settings.body_scheme.id
  if section.settings.custom_scheme
    assign scheme = section.settings.color_scheme.id
  endif
  assign map_q = section.settings.map_address | url_encode
-%}
<div class="sec color-scheme color-{{ scheme }} ct" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="wrap">
    {%- if section.blocks.size > 0 -%}
      <div class="ct-cards">
        {%- for block in section.blocks -%}
          <div class="ct-card" {{ block.shopify_attributes }}>
            <span class="ct-ic" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'phone' -%}<svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
                {%- when 'mail' -%}<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 7 9-7"/></svg>
                {%- when 'clock' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                {%- when 'chat' -%}<svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4V5Z"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11a7 7 0 0 0-14 0c0 4.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
              {%- endcase -%}
            </span>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | newline_to_br }}</p>
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="ct-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">&rarr;</span></a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="ct-main">
      <div class="ct-formcard">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.intro != blank -%}<p class="ct-intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
        {%- form 'contact', class: 'cform', novalidate: 'novalidate', data-validate: 'true' -%}
          {%- if form.posted_successfully? -%}
            <p class="notice" role="status">{{ 'contact.success' | t }}</p>
          {%- elsif form.errors -%}
            <div class="notice err" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="two">
            <label class="field">{{ 'contact.name' | t }} *<input type="text" name="contact[name]" autocomplete="name" required minlength="2" maxlength="80" data-label="{{ 'contact.name' | t | escape }}" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"><span class="ferr" data-err></span></label>
            <label class="field">{{ 'contact.email' | t }} *<input type="email" name="contact[email]" required autocomplete="email" inputmode="email" maxlength="120" data-label="{{ 'contact.email' | t | escape }}" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"><span class="ferr" data-err></span></label>
          </div>
          <label class="field">{{ 'contact.phone' | t }}<input type="tel" name="contact[phone]" autocomplete="tel" inputmode="tel" maxlength="24" pattern="[0-9+()\-\s.]{7,24}" data-label="{{ 'contact.phone' | t | escape }}" value="{{ form.phone }}"><span class="ferr" data-err></span></label>
          <label class="field">{{ 'contact.message' | t }} *<textarea name="contact[body]" required minlength="10" maxlength="2000" data-label="{{ 'contact.message' | t | escape }}">{{ form.body }}</textarea><span class="ferr" data-err></span></label>
          <div><button type="submit" class="btn primary">{{ 'contact.send' | t }} <span class="arr">&rarr;</span></button></div>
        {%- endform -%}
      </div>

      <aside class="ct-side">
        {%- if section.settings.show_map and section.settings.map_address != blank -%}
          <div class="ct-map">
            <iframe title="{{ section.settings.map_address | escape }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://maps.google.com/maps?q={{ map_q }}&amp;output=embed"></iframe>
          </div>
        {%- endif -%}
        <div class="ct-box">
          {%- if section.settings.side_heading != blank -%}<h3>{{ section.settings.side_heading | escape }}</h3>{%- endif -%}
          {%- if section.settings.side_text != blank -%}<p>{{ section.settings.side_text | escape }}</p>{%- endif -%}
          {%- if section.settings.hours != blank -%}
            <ul class="ct-hours">
              {%- assign rows = section.settings.hours | newline_to_br | split: '<br />' -%}
              {%- for r in rows -%}{%- assign pr = r | strip_newlines | split: '|' -%}<li><span>{{ pr[0] | strip }}</span><span>{{ pr[1] | strip }}</span></li>{%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="ct-links">
            {%- for i in (1..3) -%}
              {%- assign lk = 'link_' | append: i -%}
              {%- assign lb = 'link_' | append: i | append: '_label' -%}
              {%- if section.settings[lk] != blank and section.settings[lb] != blank -%}<a href="{{ section.settings[lk] }}">{{ section.settings[lb] | escape }} <span aria-hidden="true">&rarr;</span></a>{%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "info": "Off: this section follows the default color scheme in Theme settings > Colors.", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lorem ipsum" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Send us a message" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore." },
    { "type": "header", "content": "Map" },
    { "type": "checkbox", "id": "show_map", "label": "Show map", "default": true },
    { "type": "text", "id": "map_address", "label": "Map address", "info": "Street address of your shop, shown on an embedded map.", "default": "350 Fifth Avenue, New York, NY 10118" },
    { "type": "header", "content": "Side box" },
    { "type": "text", "id": "side_heading", "label": "Heading", "default": "Opening hours" },
    { "type": "text", "id": "side_text", "label": "Text", "default": "Lorem ipsum dolor sit amet, consectetur." },
    { "type": "textarea", "id": "hours", "label": "Hours", "info": "One row per line: Day | Time", "default": "Monday - Friday | 9:00 - 18:00\nSaturday | 10:00 - 16:00\nSunday | Closed" },
    { "type": "text", "id": "link_1_label", "label": "Link 1 label", "default": "Shipping & returns" },
    { "type": "url", "id": "link_1", "label": "Link 1" },
    { "type": "text", "id": "link_2_label", "label": "Link 2 label", "default": "FAQ" },
    { "type": "url", "id": "link_2", "label": "Link 2" },
    { "type": "text", "id": "link_3_label", "label": "Link 3 label", "default": "Size guide" },
    { "type": "url", "id": "link_3", "label": "Link 3" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Info card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "pin", "options": [
          { "value": "pin", "label": "Location" }, { "value": "phone", "label": "Phone" }, { "value": "mail", "label": "Email" }, { "value": "clock", "label": "Clock" }, { "value": "chat", "label": "Chat" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Visit us" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "350 Fifth Avenue\nNew York, NY 10118" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Contact", "blocks": [ { "type": "info" }, { "type": "info" }, { "type": "info" } ] } ]
}
{% endschema %}
