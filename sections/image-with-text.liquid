{%- liquid
  assign scheme = settings.body_scheme.id
  if section.settings.custom_scheme
    assign scheme = section.settings.color_scheme.id
  endif
-%}
<div class="sec color-scheme color-{{ scheme }}" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="wrap rv">
    <div class="iwt {% if section.settings.image_right %}right{% endif %}">
      <div class="iwt-media tint-{{ section.settings.tint }}">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1200', sizes: '(min-width: 990px) 46vw, 90vw', alt: section.settings.image.alt | default: section.settings.heading }}
        {%- else -%}
          <div class="iwt-art drift">{% render 'art', name: section.settings.art %}</div>
        {%- endif -%}
      </div>
      <div class="iwt-tx">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- for block in section.blocks -%}
          <div class="iwt-pt" {{ block.shopify_attributes }}><b>{{ block.settings.title | escape }}</b><span>{{ block.settings.text | escape }}</span></div>
        {%- endfor -%}
        {%- if section.settings.button != blank -%}<a class="btn primary" href="{{ section.settings.link | default: routes.collections_url }}">{{ section.settings.button | escape }} <span class="arr">→</span></a>{%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "max_blocks": 4,
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "art", "label": "Illustration (when no image)", "default": "coat", "options": [ { "value": "coat", "label": "Coat" }, { "value": "jacket", "label": "Jacket" }, { "value": "shirt", "label": "Shirt" }, { "value": "sweater", "label": "Sweater" }, { "value": "dress", "label": "Dress" } ] },
    { "type": "select", "id": "tint", "label": "Media color", "options": [ { "value": "1", "label": "Tint 1" }, { "value": "2", "label": "Tint 2" }, { "value": "3", "label": "Tint 3" }, { "value": "4", "label": "Tint 4" } ], "default": "1" },
    { "type": "checkbox", "id": "image_right", "label": "Image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Lorem ipsum <em>dolor sit</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>" },
    { "type": "text", "id": "button", "label": "Button label" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Lorem ipsum" },
        { "type": "text", "id": "text", "label": "Text", "default": "Dolor sit amet consectetur" }
      ]
    }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
