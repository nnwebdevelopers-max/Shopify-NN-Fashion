{%- comment -%}
  ============================================================================
  Section: Customer reset password (choose a new password)
  ----------------------------------------------------------------------------
  Opened from the "Reset your password" email (sent by "Forgot password?"
  in the sign-in card). The customer enters a new password twice; Shopify
  then signs them in.

      ┌──────────────┬─────────────────────────────────┐
      │ dark panel   │ Choose a new password           │
      │              │ ┌ Password ────────────────👁┐  │
      │              │ ┌ Confirm password ────────👁┐  │
      │              │ [ SAVE NEW PASSWORD       → ]   │
      └──────────────┴─────────────────────────────────┘

  Form: Shopify "reset_customer_password".

  Used in:   templates/customers/reset_password.json
  Snippets:  snippets/global-account-panel.liquid, snippets/global-account-field.liquid
  CSS:       assets/global-account.css (classes .account-page, .account-card*, .account-form*)
  JS:        assets/global-account.js (password show/hide, button spinner)
  Text:      locales → customer.reset.*, customer.fields.*
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign label_password = 'customer.fields.password' | t
  assign label_confirm = 'customer.fields.password_confirm' | t
-%}

<div class="page-width account-page">
  <div class="account-card account-card--page" data-account-card>
    {% render 'global-account-panel' %}

    <div class="account-card__main">
      {%- form 'reset_customer_password', class: 'account-form', novalidate: 'novalidate' -%}
        <span class="account-form__badge" aria-hidden="true">{% render 'global-icon', name: 'lock', size: 26 %}</span>
        <h1 class="account-form__title">{{ 'customer.reset.title' | t }}</h1>
        <p class="account-form__subtitle">{{ 'customer.reset.subtitle' | t }}</p>

        {%- if form.errors -%}
          <div class="account-form__errors" role="alert">
            <p>{{ 'customer.errors_title' | t }}</p>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        {% render 'global-account-field',
          id: 'ResetPassword',
          name: 'customer[password]',
          type: 'password',
          label: label_password,
          autocomplete: 'new-password',
          required: true
        %}
        {% render 'global-account-field',
          id: 'ResetPasswordConfirm',
          name: 'customer[password_confirmation]',
          type: 'password',
          label: label_confirm,
          autocomplete: 'new-password',
          required: true
        %}

        <button type="submit" class="button button--lg button--full account-form__submit">
          <span>{{ 'customer.reset.submit' | t }}</span>
          {% render 'global-icon', name: 'arrow-right', size: 18 %}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

{%- comment -%}
  Schema (theme editor settings) — JSON cannot contain comments, so they live here.
  No section settings: the side panel is set in Theme settings > Customer accounts.
{%- endcomment -%}
{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "class": "section-customer-reset-password",
  "enabled_on": {
    "templates": ["customers/reset_password"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Side panel image, heading, text and perks: Theme settings > Customer accounts."
    }
  ]
}
{% endschema %}
