{%- comment -%}
  ============================================================================
  Section: Product recommendations ("You may also like", product page)
  ----------------------------------------------------------------------------
      YOU MAY ALSO LIKE                                   View all →
      ┌──────┐ ┌──────┐ ┌──────┐ ┌──────┐
      │ card │ │ card │ │ card │ │ card │   ← the site's normal product cards
      └──────┘ └──────┘ └──────┘ └──────┘

  How it loads:
  1. On the product page this section renders an empty frame with a URL
     (data-url) to Shopify's recommendations endpoint for this product.
  2. assets/product.js fetches that URL (Section Rendering API): Shopify
     renders this same file again with recommendations.products filled
     (related products, worked out by Shopify), and the script swaps the
     result in.
  3. No recommendations yet (new stores): the "Fallback collection"
     products are shown instead (the current product is left out).
  If there is nothing to show, the section stays empty (no heading).

  Used in:   templates/product.json ("recommendations")
  Snippets:  snippets/global-product-card.liquid
  CSS:       assets/product.css → "Recommendations", assets/global-product-card.css
  JS:        assets/product.js → "Recommendations"
  Text:      locales → products.product.recommendations, products.product.view_all
             (heading / link label can be overridden in the editor)
  ============================================================================
{%- endcomment -%}

{%- liquid
  if section.settings.heading != blank
    assign heading = section.settings.heading | escape
  else
    assign heading = 'products.product.recommendations' | t
  endif

  # Products to show: Shopify's recommendations, else the fallback collection
  assign items = recommendations.products
  assign from_fallback = false
  if recommendations.performed? and recommendations.products_count == 0 and section.settings.fallback_collection != blank
    assign items = section.settings.fallback_collection.products
    assign from_fallback = true
  endif

  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and section.settings.fallback_collection != blank
    assign view_all_url = section.settings.fallback_collection.url
  endif

  case section.settings.image_ratio
    when 'square'
      assign card_ratio = '1 / 1'
    when 'landscape'
      assign card_ratio = '4 / 3'
    else
      assign card_ratio = '3 / 4'
  endcase
-%}

<section
  class="page-width product-recs"
  data-recommendations
  data-scroll-fx="product-recs"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit | plus: 1 }}&intent=related"
  data-current-handle="{{ product.handle }}"
  data-limit="{{ section.settings.limit }}"
  style="--recs-columns: {{ section.settings.columns_desktop }}; --card-ratio: {{ card_ratio }};"
>
  {%- comment -%} Filled only in the version Shopify renders for the endpoint (see header) {%- endcomment -%}
  {%- if recommendations.performed? and items.size > 0 -%}
    <div class="product-recs__head">
      <h2 class="product-recs__title">{{ heading }}</h2>
      {%- if view_all_url != blank -%}
        <a href="{{ view_all_url }}" class="button button--link product-recs__link">
          {%- if section.settings.view_all_label != blank -%}
            {{ section.settings.view_all_label | escape }}
          {%- else -%}
            {{ 'products.product.view_all' | t }}
          {%- endif -%}
          {% render 'global-icon', name: 'arrow-right', size: 16 %}
        </a>
      {%- endif -%}
    </div>

    <ul class="product-recs__grid" role="list" data-recs-grid {% if from_fallback %}data-fallback{% endif %}>
      {%- for item in items limit: 12 -%}
        <li class="product-recs__item" data-recs-handle="{{ item.handle }}">
          {% render 'global-product-card',
            product: item,
            image_sizes: '(min-width: 990px) 25vw, 50vw',
            show_secondary_image: true,
            show_options: true
          %}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{%- comment -%}
  Schema (theme editor settings) — JSON cannot contain comments, so they live here.
  - enabled_on.templates: ["product"]
  Settings: heading / view_all_label (empty → translated defaults), limit (2–8),
            columns_desktop (3–5), image_ratio, fallback_collection,
            view_all_link (empty → the fallback collection)
{%- endcomment -%}
{% schema %}
{
  "name": "Product recommendations",
  "tag": "div",
  "class": "section-product-recommendations",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the translated default (\"You may also like\")."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Products per row on desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "portrait"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection",
      "info": "Shown when Shopify has no recommendations for a product yet (common on new stores)."
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "\"View all\" link",
      "info": "Leave empty to link to the fallback collection."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" label",
      "info": "Leave empty to use the translated default (\"View all\")."
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
