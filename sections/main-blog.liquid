{%- paginate blog.articles by section.settings.per_page -%}
<div class="color-scheme color-{% if section.settings.custom_scheme %}{{ section.settings.color_scheme.id }}{% else %}{{ settings.body_scheme.id }}{% endif %}">
  <div class="wrap">
    {%- if section.settings.show_breadcrumbs -%}{% render 'breadcrumbs', last: blog.title %}{%- endif -%}
    <div class="jhead">
      {%- if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif -%}
      <h1>{{ section.settings.heading | default: blog.title | escape }}</h1>
    </div>

    {%- if blog.all_tags.size > 0 and section.settings.show_tags -%}
      <div class="subchips">
        <a href="{{ blog.url }}" aria-current="{% if current_tags == blank %}true{% else %}false{% endif %}">{{ 'blog.all' | t }}</a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" aria-current="{% if current_tags contains tag %}true{% else %}false{% endif %}">{{ tag | escape }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for article in blog.articles -%}
      {%- assign tn = forloop.index0 | modulo: 4 | plus: 1 -%}
      {%- if forloop.first and paginate.current_page == 1 -%}
        <a class="jfeat" href="{{ article.url }}">
          <div class="jart tint-{{ tn }}">{% render 'article-art', article: article, width: 1200 %}</div>
          <div>
            {%- if article.tags.size > 0 %}<span class="tag">{{ article.tags.first | escape }}</span>{% endif -%}
            <h2>{{ article.title | escape }}</h2>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 32 }}</p>
            <div class="jmeta">{{ article.published_at | time_tag: format: 'month_day_year' }}{% if section.settings.show_author %} · {{ article.author | escape }}{% endif %}</div>
          </div>
        </a>
        <div class="jgrid">
      {%- else -%}
        {%- if forloop.first %}<div class="jgrid">{% endif -%}
        <a class="post" href="{{ article.url }}">
          <div class="jart tint-{{ tn }}">{% render 'article-art', article: article, width: 800 %}</div>
          <div>
            {%- if article.tags.size > 0 %}<span class="tag">{{ article.tags.first | escape }}</span>{% endif -%}
            <h3 style="margin-top:6px">{{ article.title | escape }}</h3>
            <p style="margin-top:8px">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            <div class="jmeta">{{ article.published_at | time_tag: format: 'month_day_year' }}</div>
          </div>
        </a>
      {%- endif -%}
      {%- if forloop.last %}</div>{% endif -%}
    {%- else -%}
      <p class="rte" style="padding-block:40px">{{ 'blog.empty' | t }}</p>
    {%- endfor -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination: previous: '←', next: '→' }}</nav>
    {%- endif -%}
  </div>
  <div style="height:{{ section.settings.padding_bottom }}px"></div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "info": "Off: this section follows the default color scheme in Theme settings > Colors.", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lorem ipsum" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the blog title." },
    { "type": "checkbox", "id": "show_tags", "label": "Show tag filter", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "range", "id": "per_page", "label": "Posts per page", "min": 4, "max": 24, "step": 1, "default": 10 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 100 }
  ]
}
{% endschema %}
