{%- comment -%}
  ============================================================================
  Section: About hero (scroll hero, About page)
  ----------------------------------------------------------------------------
  Animated (GSAP, assets/global-scroll-animations.js) — the section is 3 screens tall and its
  stage stays pinned while you scroll:

      scroll 0%                  scroll 40%                 scroll 100%
      ┌──────────────────┐       ┌──────────────────┐       ┌──────────────────┐
      │   OUR STORY      │       │                  │       │                  │
      │ Clothes made for │       │  ┌────────────┐  │       │  full-screen     │
      │   real days…     │  →    │  │  growing   │  │  →    │     photo        │
      │ ▢   ┌──────┐   ▢ │       │  │   photo    │  │       │ Made for real    │
      │  ▢  │photo │  ▢  │       │  └────────────┘  │       │ life. ……         │
      └──────────────────┘       └──────────────────┘       └──────────────────┘
  - Heading words rise in on load; the intro then lifts away
  - Floating photos (blocks) drift outward and fade
  - The main photo grows from a rounded card to the full screen
    (clip-path) while zooming out inside
  - The overlay heading/text fades in over the full photo

  Static (no JS / reduced motion): heading, then the photo with its overlay.

  Used in:   templates/page.about.json
  CSS:       assets/about.css → "2. Scroll hero" (.about-hero*)
  JS:        assets/global-scroll-animations.js → initHero()
  Text:      typed in the theme editor; locales → about.scroll_hint
  ============================================================================
{%- endcomment -%}

<section
  class="about about-hero{% if section.settings.serif %} about--serif{% endif %}"
  data-about="hero"
  style="--about-bg: {{ section.settings.background_color }}; --about-text: {{ section.settings.text_color }}; --about-accent: {{ section.settings.accent_color }};"
>
  <div class="about-hero__stage" data-hero-stage>
    <div class="about-hero__intro" data-hero-intro>
      {%- if section.settings.eyebrow != blank -%}
        <p class="about__eyebrow" data-hero-fade>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="about__heading" data-split>{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="about__text" data-hero-fade>{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- comment -%} Main photo (grows to full screen) + overlay text {%- endcomment -%}
    <div class="about-hero__media" data-hero-media>
      <div class="about-hero__frame" data-hero-frame>
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'about__placeholder' }}
        {%- endif -%}
      </div>
      {%- if section.settings.overlay_heading != blank or section.settings.overlay_text != blank -%}
        <div class="about-hero__overlay" data-hero-overlay>
          {%- if section.settings.overlay_heading != blank -%}
            <h2 class="about__heading">{{ section.settings.overlay_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.overlay_text != blank -%}
            <p>{{ section.settings.overlay_text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Floating photos (animated layout only, up to 4 blocks) {%- endcomment -%}
    {%- for block in section.blocks limit: 4 -%}
      <div class="about-hero__float about-hero__float--{{ forloop.index }}" data-hero-float {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'eager', alt: '', widths: '250, 400, 500', sizes: '15vw' }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'about__placeholder' }}
        {%- endif -%}
      </div>
    {%- endfor -%}

    <div class="about-hero__hint" aria-hidden="true" data-hero-hint>
      <span>{{ 'about.scroll_hint' | t }}</span>
      <span class="about-hero__hint-line"></span>
    </div>
  </div>
</section>

{%- comment -%}
  Schema (theme editor settings) — JSON cannot contain comments, so they live here.
  - enabled_on.templates: ["page"] (built for the page.about template)
  Settings: eyebrow, heading, text, image (main photo), overlay_heading,
            overlay_text, serif, background/text/accent colors
  Blocks:   float (image) — up to 4 photos around the card
{%- endcomment -%}
{% schema %}
{
  "name": "About: scroll hero",
  "tag": "div",
  "class": "section-about-hero",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clothes made for real days, not just the photo." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We design easy, everyday pieces that look good, feel good and fit into the life you already live.</p>" },
    { "type": "image_picker", "id": "image", "label": "Main image", "info": "Grows to full screen while scrolling. 2400 × 1400 px recommended." },
    { "type": "text", "id": "overlay_heading", "label": "Heading on the full image", "default": "Made for real life." },
    { "type": "text", "id": "overlay_text", "label": "Text on the full image", "default": "Easy pieces that pair with each other and still look right at the end of a long day." },
    { "type": "header", "content": "Style" },
    { "type": "checkbox", "id": "serif", "label": "Serif headings", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F6F3EC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2F3A2F" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B8734F" }
  ],
  "blocks": [
    {
      "type": "float",
      "name": "Floating photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About: scroll hero",
      "blocks": [{ "type": "float" }, { "type": "float" }, { "type": "float" }, { "type": "float" }]
    }
  ]
}
{% endschema %}
