{%- liquid
  assign scheme = settings.body_scheme.id
  if section.settings.custom_scheme
    assign scheme = section.settings.color_scheme.id
  endif
-%}
<section class="sec color-scheme color-{{ scheme }}" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="wrap">
    <div class="mhead rv">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    </div>
    <div class="zz">
      {%- for block in section.blocks -%}
        {%- liquid
          assign flip = forloop.index0 | modulo: 2
          assign c = block.settings.collection
          assign img = block.settings.image
          if img == blank and c != blank
            assign img = c.image
            if img == blank and c.products.first
              assign img = c.products.first.featured_media
            endif
          endif
          assign img2 = block.settings.image_2
          if img2 == blank and c != blank and c.products.size > 1
            assign img2 = c.products[1].featured_media
          endif
          assign title = block.settings.title | default: c.title
        -%}
        <div class="zrow rv{% if flip == 1 %} flip{% endif %}" {{ block.shopify_attributes }}>
          <div class="zimg">
            <a class="big" href="{{ c.url | default: routes.collections_url }}">{%- if img != blank -%}{{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 900px) 34vw, 70vw', alt: title }}{%- endif -%}</a>
            <a class="small" href="{{ c.url | default: routes.collections_url }}" tabindex="-1" aria-hidden="true">{%- if img2 != blank -%}{{ img2 | image_url: width: 500 | image_tag: loading: 'lazy', widths: '300,500', sizes: '24vw', alt: '' }}{%- endif -%}</a>
          </div>
          <div class="ztx">
            <span class="num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3>{{ title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
            <a class="ghost" href="{{ c.url | default: routes.collections_url }}">{{ block.settings.button | default: 'Shop now' | escape }}</a>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zig-zag categories",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lorem ipsum" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
        { "type": "text", "id": "text", "label": "Text", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit." },
        { "type": "text", "id": "button", "label": "Button label", "default": "Shop now" },
        { "type": "image_picker", "id": "image", "label": "Large image", "info": "Defaults to the collection image or its first product." },
        { "type": "image_picker", "id": "image_2", "label": "Small image", "info": "Defaults to the collection's second product." }
      ]
    }
  ],
  "presets": [ { "name": "Zig-zag categories", "blocks": [ { "type": "category" }, { "type": "category" }, { "type": "category" } ] } ]
}
{% endschema %}
