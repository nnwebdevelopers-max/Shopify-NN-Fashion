{%- liquid
  assign scheme = settings.body_scheme.id
  if section.settings.custom_scheme
    assign scheme = section.settings.color_scheme.id
  endif
  assign slides = section.blocks | where: 'type', 'slide'
-%}
{%- if slides.size > 0 -%}
<section class="mhero color-scheme color-{{ scheme }}" id="Hero-{{ section.id }}" data-mhero data-autoplay="{{ section.settings.autoplay }}" data-duration="{{ section.settings.duration }}" style="--hh:{{ section.settings.height }}vh" aria-roledescription="carousel" aria-label="{{ section.settings.aria_label | default: 'Featured looks' | escape }}">
  {%- for block in slides -%}
    <div class="mh-slide{% if forloop.first %} on{% endif %}" data-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {%- if forloop.first -%}
          {{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800,1200,1600,2000', sizes: '100vw', alt: block.settings.image.alt | default: block.settings.heading }}
        {%- else -%}
          {{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '800,1200,1600,2000', sizes: '100vw', alt: block.settings.image.alt | default: block.settings.heading }}
        {%- endif -%}
      {%- else -%}
        <div class="mh-ph"></div>
      {%- endif -%}
    </div>
  {%- endfor -%}
  <div class="mh-shade" aria-hidden="true"></div>
  <div class="mh-count" aria-hidden="true"><b data-mh-now>01</b><span>/ {{ slides.size | at_least: 1 | prepend: '0' | slice: -2, 2 }}</span></div>

  <div class="mh-text">
    {%- for block in slides -%}
      <div class="mh-t{% if forloop.first %} on{% endif %}" data-slide="{{ forloop.index0 }}">
        {%- if block.settings.kicker != blank -%}<div class="k">{{ block.settings.kicker | escape }}</div>{%- endif -%}
        {%- if block.settings.heading != blank -%}<h1>{{ block.settings.heading | escape }}</h1>{%- endif -%}
        {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
        {%- if block.settings.button != blank -%}<a class="ghost" href="{{ block.settings.link | default: routes.collections_url }}">{{ block.settings.button | escape }}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_looks -%}
  <div class="mh-looks">
    {%- for block in slides -%}
      {%- liquid
        assign has_look = false
        if block.settings.product_1 != blank or block.settings.product_2 != blank or block.settings.product_3 != blank
          assign has_look = true
        endif
      -%}
      <div class="mh-look{% if forloop.first %} on{% endif %}" data-slide="{{ forloop.index0 }}">
        {%- if has_look -%}
          <div class="mh-lt">{{ section.settings.looks_label | escape }}</div>
          {%- for i in (1..3) -%}
            {%- liquid
              assign key = 'product_' | append: i
              assign p = block.settings[key]
            -%}
            {%- if p != blank -%}
              <div class="mh-card">
                {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}<span class="mh-noimg"></span>{%- endif -%}
                <a class="mh-info" href="{{ p.url }}"><b>{{ p.title | escape }}</b><span>{{ p.price | money }}</span></a>
                {%- if p.available -%}
                  {%- if p.has_only_default_variant -%}
                    <form method="post" action="{{ routes.cart_add_url }}" data-cart-form class="mh-add-f">
                      <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1">
                      <button type="submit" class="mh-add" aria-label="{{ 'products.add_to_cart' | t }}: {{ p.title | escape }}"><span class="atc-label">+</span></button>
                    </form>
                  {%- else -%}
                    <a class="mh-add" href="{{ p.url }}" data-quick-view="{{ p.url }}" aria-haspopup="dialog" aria-label="{{ 'products.quick_add' | t }}: {{ p.title | escape }}">+</a>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- endif -%}

  {%- if slides.size > 1 -%}
    <button type="button" class="mh-arr mh-prev" data-mh-prev aria-label="Previous">&larr;</button>
    <button type="button" class="mh-arr mh-next" data-mh-next aria-label="Next">&rarr;</button>
    <div class="mh-tabs" role="tablist">
      {%- for block in slides -%}
        <button type="button" class="mh-tab{% if forloop.first %} on{% endif %}" role="tab" data-go="{{ forloop.index0 }}"><i class="mh-bar"><u></u></i><span class="n">0{{ forloop.index }}</span><span class="l">{{ block.settings.tab_label | default: block.settings.heading | escape }}</span></button>
      {%- endfor -%}
      <button type="button" class="mh-pause" data-mh-pause aria-label="Pause">&#10073;&#10073;</button>
    </div>
  {%- endif -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Hero slider",
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "range", "id": "height", "label": "Height", "min": 50, "max": 100, "step": 2, "unit": "vh", "default": 80 },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "duration", "label": "Seconds per slide", "min": 3, "max": 15, "step": 1, "default": 7 },
    { "type": "checkbox", "id": "show_looks", "label": "Show “Shop this look” products", "default": true },
    { "type": "text", "id": "looks_label", "label": "Shop this look label", "default": "Shop this look" },
    { "type": "text", "id": "aria_label", "label": "Carousel accessibility label", "default": "Featured looks" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Recommended: 2000 × 1100 px. Keep the left side calm, the text sits there." },
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Lorem ipsum" },
        { "type": "text", "id": "kicker", "label": "Small heading", "default": "Lorem ipsum | Dolor sit" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Lorem ipsum dolor" },
        { "type": "text", "id": "text", "label": "Text", "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit." },
        { "type": "text", "id": "button", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "header", "content": "Shop this look" },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "product", "id": "product_3", "label": "Product 3" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Hero slider", "blocks": [ { "type": "slide" }, { "type": "slide" }, { "type": "slide" } ] }
  ]
}
{% endschema %}
