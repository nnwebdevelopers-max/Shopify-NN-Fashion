{%- liquid
  assign scheme = settings.body_scheme.id
  if section.settings.custom_scheme
    assign scheme = section.settings.color_scheme.id
  endif
-%}
<div class="bigband color-scheme color-{{ scheme }}" aria-hidden="true">
  {%- for block in section.blocks -%}
    {%- assign rv = forloop.index0 | modulo: 2 -%}
    <div class="brow{% if rv == 1 %} rev{% endif %}" {{ block.shopify_attributes }}>
      <div class="btrack" style="--dur:{{ section.settings.speed }}s">
        {%- for i in (1..4) -%}<span>{{ block.settings.text | escape }}</span><span class="dot">&#9679;</span>{%- endfor -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Big text band",
  "max_blocks": 3,
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "range", "id": "speed", "label": "Scroll duration", "min": 10, "max": 90, "step": 5, "unit": "s", "default": 40 }
  ],
  "blocks": [ { "type": "row", "name": "Text row", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Lorem ipsum dolor" } ] } ],
  "presets": [ { "name": "Big text band", "blocks": [ { "type": "row" }, { "type": "row" } ] } ]
}
{% endschema %}
