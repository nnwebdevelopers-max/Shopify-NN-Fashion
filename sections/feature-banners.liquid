<div class="sec color-scheme color-{% if section.settings.custom_scheme %}{{ section.settings.color_scheme.id }}{% else %}{{ settings.body_scheme.id }}{% endif %}" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="wrap rv">
    <div class="feature" style="--n:{{ section.blocks.size | at_least: 1 | at_most: 3 }}">
      {%- for block in section.blocks -%}
        <article class="fb {% if block.settings.style == 'dark' %}dark{% else %}tint-{{ block.settings.style }}{% endif %}" {{ block.shopify_attributes }}>
          <div class="art">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: '' }}
            {%- else -%}
              {% render 'art', name: block.settings.art %}
            {%- endif -%}
          </div>
          {%- if block.settings.eyebrow != blank %}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif -%}
          {%- if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif -%}
          {%- if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif -%}
          {%- if block.settings.button != blank %}<a class="btn primary" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button | escape }} <span class="arr">→</span></a>{% endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature banners",
  "max_blocks": 3,
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "info": "Off: this section follows the default color scheme in Theme settings > Colors.", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lorem" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Lorem ipsum dolor sit." },
        { "type": "text", "id": "text", "label": "Text", "default": "Consectetur adipiscing elit, sed do eiusmod tempor." },
        { "type": "text", "id": "button", "label": "Button label", "default": "Lorem ipsum" },
        { "type": "url", "id": "link", "label": "Button link" },
        {
          "type": "select", "id": "style", "label": "Background",
          "options": [ { "value": "1", "label": "Tint 1" }, { "value": "2", "label": "Tint 2" }, { "value": "3", "label": "Tint 3" }, { "value": "4", "label": "Tint 4" }, { "value": "dark", "label": "Inverted" } ],
          "default": "3"
        },
        {
          "type": "select", "id": "art", "label": "Illustration",
          "options": [
            { "value": "jacket", "label": "Jacket" }, { "value": "coat", "label": "Coat" }, { "value": "hoodie", "label": "Hoodie" },
            { "value": "sweater", "label": "Sweater" }, { "value": "tee", "label": "Tee" }, { "value": "dress", "label": "Dress" }, { "value": "jeans", "label": "Jeans" },
            { "value": "sneaker", "label": "Sneaker" }, { "value": "boot", "label": "Boot" }, { "value": "backpack", "label": "Backpack" }, { "value": "cap", "label": "Cap" },
            { "value": "scarf", "label": "Scarf" }, { "value": "belt", "label": "Belt" }, { "value": "sunglasses", "label": "Sunglasses" }
          ],
          "default": "jacket"
        },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Overrides the illustration." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature banners",
      "blocks": [
        { "type": "banner", "settings": { "style": "3", "art": "speaker" } },
        { "type": "banner", "settings": { "style": "1", "art": "laptop" } }
      ]
    }
  ]
}
{% endschema %}
