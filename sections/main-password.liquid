<div class="color-scheme color-{% if section.settings.custom_scheme %}{{ section.settings.color_scheme.id }}{% else %}{{ settings.body_scheme.id }}{% endif %}" style="min-height:100vh;min-height:100dvh;display:grid;place-items:center;padding:24px">
  <div style="max-width:560px;display:grid;gap:20px;text-align:center;justify-items:center">
    <span class="logo"><i></i>{{ shop.name | escape }}</span>
    <h1 style="font-size:clamp(40px,7vw,72px)">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="rte">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'form', style: 'width:100%' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <input type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}" aria-label="{{ 'newsletter.email' | t }}">
      <button class="btn primary" type="submit">{{ 'newsletter.notify' | t }}</button>
    {%- endform -%}
    <details>
      <summary class="link" style="cursor:pointer;list-style:none">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'form', style: 'margin-top:16px' -%}
        <input type="password" name="password" required placeholder="{{ 'password.label' | t }}" aria-label="{{ 'password.label' | t }}">
        <button class="btn primary" type="submit">{{ 'password.submit' | t }}</button>
        {%- if form.errors -%}<p class="perr">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "checkbox", "id": "custom_scheme", "label": "Use a different color scheme", "info": "Off: this section follows the default color scheme in Theme settings > Colors.", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "visible_if": "{{ section.settings.custom_scheme }}" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lorem ipsum, opening soon." }
  ]
}
{% endschema %}
