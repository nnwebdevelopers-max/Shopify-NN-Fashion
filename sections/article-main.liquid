{%- comment -%}
  ============================================================================
  Section: Article main (one blog post, /blogs/<blog>/<post>)
  ----------------------------------------------------------------------------
      ━━━━━━━━━━━━━━━━━━━━━━ reading progress bar (top of the screen)
      ┌──────────────────────────────────────────────────────┐
      │                 big rounded photo                     │
      │   [News]                                              │
      │   How to style an oversized hoodie                    │ ← title over the photo
      │   ── 📅 Apr 21, 2026 · 🕑 4 min read · By Jane         │
      └──────────────────────────────────────────────────────┘
      SHARE        Post text in a reading column…
      (f)(x)(p)(🔗) ## Headings, images, quotes…
      (sticky)      TAGGED: [Style] [Trends]
                    ── comments + comment form (when enabled) ──
  Layout from the Athora theme's article page.
  Animated (GSAP, assets/global-scroll-animations.js → initArticleMain):
  the photo opens from an inset card and zooms out; title words rise; the
  text's paragraphs/images fade up as you reach them; share buttons slide
  in; the progress bar fills with the reading position. Copy link: JS.
  Without a post image the header is a plain colored band.

  Comments appear when they're turned on for the blog (Online Store >
  Blog posts > Manage blogs).

  Used in:   templates/article.json
  CSS:       assets/blog.css → "5. Article" (.article*)
  JS:        assets/global-scroll-animations.js → initArticleMain()
  Text:      locales → blog.*
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign published = article.published_at | date: format: 'month_day_year'
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200 | at_least: 1
  assign share_url = shop.url | append: article.url
  assign share_url_encoded = share_url | url_encode
  assign share_title = article.title | url_encode
  assign image_alt = article.image.alt | default: article.title
-%}

<article
  class="article{% if section.settings.serif %} article--serif{% endif %}{% unless article.image %} article--no-image{% endunless %}"
  data-scroll-fx="article-main"
  style="--blog-bg: {{ section.settings.background_color }}; --blog-text: {{ section.settings.text_color }}; --blog-accent: {{ section.settings.accent_color }};"
>
  <div class="blog-progress" aria-hidden="true"><span data-article-progress></span></div>

  {%- comment -%} ---------- Header: photo + title over it ---------- {%- endcomment -%}
  <header class="article-hero">
    {%- if article.image -%}
      <figure class="article-hero__media" data-article-media>
        {{ article.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: image_alt, class: 'article-hero__image' }}
      </figure>
    {%- endif -%}
    <div class="article-hero__content">
      <a href="{{ blog.url }}" class="blog-tag blog-tag--light" data-fade>{{ blog.title | escape }}</a>
      <h1 class="article-hero__title" data-split>{{ article.title | escape }}</h1>
      <p class="article-hero__meta" data-fade>
        <span class="article-hero__line" aria-hidden="true"></span>
        <span>{% render 'global-icon', name: 'calendar', size: 15 %}<time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ published }}</time></span>
        {%- if section.settings.show_reading_time -%}
          <span>{% render 'global-icon', name: 'clock', size: 15 %}{{ 'blog.reading_time' | t: minutes: minutes }}</span>
        {%- endif -%}
        {%- if section.settings.show_author and article.author != blank -%}
          <span>{{ 'blog.by_author' | t: author: article.author }}</span>
        {%- endif -%}
      </p>
    </div>
  </header>

  {%- comment -%} ---------- Share + text ---------- {%- endcomment -%}
  <div class="article__layout">
    {%- if section.settings.show_share -%}
      <aside class="article-share" data-article-share>
        <p class="article-share__label">{{ 'blog.share' | t }}</p>
        <div class="article-share__buttons">
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url_encoded }}" class="button button--outline button--icon article-share__button" target="_blank" rel="noopener nofollow" aria-label="{{ 'blog.share_on' | t: network: 'Facebook' }}">
            {% render 'global-icon', name: 'facebook', size: 18 %}
          </a>
          <a href="https://twitter.com/intent/tweet?url={{ share_url_encoded }}&text={{ share_title }}" class="button button--outline button--icon article-share__button" target="_blank" rel="noopener nofollow" aria-label="{{ 'blog.share_on' | t: network: 'X' }}">
            {% render 'global-icon', name: 'x', size: 16 %}
          </a>
          <a href="https://pinterest.com/pin/create/button/?url={{ share_url_encoded }}{% if article.image %}&media={{ article.image | image_url: width: 1200 | prepend: 'https:' | url_encode }}{% endif %}&description={{ share_title }}" class="button button--outline button--icon article-share__button" target="_blank" rel="noopener nofollow" aria-label="{{ 'blog.share_on' | t: network: 'Pinterest' }}">
            {% render 'global-icon', name: 'pinterest', size: 18 %}
          </a>
          <button
            type="button"
            class="button button--outline button--icon article-share__button"
            data-copy-link="{{ share_url }}"
            aria-label="{{ 'blog.copy_link' | t }}"
            data-text-copied="{{ 'blog.link_copied' | t }}"
          >
            {% render 'global-icon', name: 'link', size: 18 %}
          </button>
        </div>
        <span class="article-share__status" role="status" data-copy-status></span>
      </aside>
    {%- endif -%}

    <div class="article__main">
      <div class="article-rte" data-article-content>{{ article.content }}</div>

      {%- if section.settings.show_tags and article.tags.size > 0 -%}
        <div class="article__tags" data-fade>
          <span class="article__tags-label">{{ 'blog.tags' | t }}</span>
          {%- for tag in article.tags -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="blog-tag">{{ tag | escape }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} ---------- Comments (only when enabled for the blog) ---------- {%- endcomment -%}
      {%- if blog.comments_enabled? -%}
        <section class="article-comments" id="Comments">
          {%- if article.comments_count > 0 -%}
            <h2 class="article-comments__title">
              {%- if article.comments_count == 1 -%}
                {{ 'blog.comments_one' | t: number: article.comments_count }}
              {%- else -%}
                {{ 'blog.comments_other' | t: number: article.comments_count }}
              {%- endif -%}
            </h2>
            {%- paginate article.comments by 20 -%}
              <ul class="article-comments__list" role="list">
                {%- for comment in article.comments -%}
                  <li class="article-comment">
                    <p class="article-comment__author">{{ comment.author | escape }} · <span>{{ comment.created_at | date: format: 'month_day_year' }}</span></p>
                    <div class="article-comment__body">{{ comment.content }}</div>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endpaginate -%}
          {%- endif -%}

          {%- form 'new_comment', article, class: 'article-comments__form' -%}
            <h2 class="article-comments__title">{{ 'blog.comment_title' | t }}</h2>
            {%- if form.posted_successfully? -%}
              <p class="article-comments__notice" role="status">
                {%- if blog.moderated? -%}{{ 'blog.comment_pending' | t }}{%- else -%}{{ 'blog.comment_posted' | t }}{%- endif -%}
              </p>
            {%- endif -%}
            {%- if form.errors -%}
              <div class="article-comments__errors" role="alert">{{ form.errors | default_errors }}</div>
            {%- endif -%}
            <div class="article-comments__row">
              <label class="article-comments__field">
                <span>{{ 'blog.comment_name' | t }}</span>
                <input type="text" name="comment[author]" value="{{ form.author }}" autocomplete="name" required>
              </label>
              <label class="article-comments__field">
                <span>{{ 'blog.comment_email' | t }}</span>
                <input type="email" name="comment[email]" value="{{ form.email }}" autocomplete="email" required>
              </label>
            </div>
            <label class="article-comments__field">
              <span>{{ 'blog.comment_body' | t }}</span>
              <textarea name="comment[body]" rows="5" required>{{ form.body }}</textarea>
            </label>
            {%- if blog.moderated? -%}
              <p class="article-comments__hint">{{ 'blog.comment_moderated' | t }}</p>
            {%- endif -%}
            <button type="submit" class="button blog-button">
              {{- 'blog.comment_post' | t -}}
              {% render 'global-icon', name: 'arrow-right', size: 16 %}
            </button>
          {%- endform -%}
        </section>
      {%- endif -%}
    </div>
  </div>
</article>

{%- comment -%}
  Schema — settings: show_reading_time, show_author, show_share, show_tags,
  serif, colors
{%- endcomment -%}
{% schema %}
{
  "name": "Blog post",
  "tag": "div",
  "class": "section-article-main",
  "enabled_on": { "templates": ["article"] },
  "settings": [
    { "type": "checkbox", "id": "show_reading_time", "label": "Show reading time", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Show share buttons", "default": true },
    { "type": "checkbox", "id": "show_tags", "label": "Show tags", "default": true },
    { "type": "header", "content": "Style" },
    { "type": "checkbox", "id": "serif", "label": "Serif headings", "default": true },
    { "type": "color", "id": "background_color", "label": "Background (no photo)", "default": "#F6F3EC" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2F3A2F" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#B8734F" }
  ]
}
{% endschema %}
