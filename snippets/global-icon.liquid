{%- comment -%}
  ============================================================================
  Snippet: Icon
  ----------------------------------------------------------------------------
  Inline SVG icons used across the theme. Icons use "currentColor", so they
  take the text color of their parent.

  Parameters:
  - name  {String}  required. One of:
                    UI:       search, account, gift, cart, phone, chevron-down,
                              chevron-left, chevron-right, close, menu, eye,
                              eye-off, trash
                    Features: return, shield, box, truck, chat, lock, star, heart
                              (+ gift, phone)
                    Footer:   arrow-right, mail, map-pin
                    Cards:    compare, check (+ heart, cart)
                    Cart:     tag (+ truck, edit)
                    Blog:     calendar, clock, link (+ arrow-right, facebook, x, pinterest)
                    Product:  ruler, zoom, chevron-up (+ star, heart, cart, truck, return, lock, check)
                    Accounts: logout, edit, plus, bolt, arrow-left
                              (+ account, box, map-pin, heart, lock, mail)
                    Social:   facebook, instagram, pinterest, youtube, tiktok, x
  - size  {Number}  optional, width/height in px (default 20)

  Usage:
  {% render 'global-icon', name: 'search', size: 18 %}

  Used in:  sections/header.liquid, sections/header-top-bar.liquid,
            snippets/header-search.liquid, snippets/header-drawer.liquid,
            snippets/header-localization-form.liquid,
            sections/homepage-slideshow.liquid, sections/homepage-features.liquid,
            sections/homepage-testimonials.liquid, sections/footer.liquid
  CSS:      none (sized by the width/height attributes)
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign icon_size = size | default: 20
-%}

{%- comment -%}
  Every icon shares the same outer svg tag: 24×24 viewBox, stroke icons,
  aria-hidden because the buttons/links around them have their own labels.
{%- endcomment -%}
<svg
  class="icon icon--{{ name }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>
    {%- when 'gift' -%}
      <rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v9h14v-9M12 8v13M12 8S10.5 3 8 4s-1 4 4 4M12 8s1.5-5 4-4 1 4-4 4"/>
    {%- when 'cart' -%}
      <path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'phone' -%}
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'close' -%}
      <path d="M18 6 6 18M6 6l12 12"/>
    {%- when 'menu' -%}
      <path d="M3 6h18M3 12h18M3 18h18"/>
    {%- when 'eye' -%}
      <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>
    {%- when 'eye-off' -%}
      <path d="M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-2.2 3.2M6.6 6.6A17 17 0 0 0 2 12s3.5 7 10 7a9.7 9.7 0 0 0 5.4-1.6M3 3l18 18M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
    {%- when 'trash' -%}
      <path d="M4 7h16M9 7V4h6v3M6 7l1 14h10l1-14M10 11v6M14 11v6"/>
    {%- when 'chevron-left' -%}
      <path d="m15 6-6 6 6 6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 6 6 6-6 6"/>

    {%- comment -%} ---------- Feature icons (homepage-features "Icon" setting) ---------- {%- endcomment -%}
    {%- when 'return' -%}
      <path d="M20 11a8 8 0 0 0-14.3-4.9L4 8M4 4v4h4M4 13a8 8 0 0 0 14.3 4.9L20 16M20 20v-4h-4"/>
    {%- when 'shield' -%}
      <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'box' -%}
      <rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9M10 13h4"/>
    {%- when 'truck' -%}
      <path d="M2 6h12v10H2zM14 9h4l4 4v3h-8"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
    {%- when 'chat' -%}
      <path d="M21 12a8 8 0 0 1-11.8 7L4 20l1-4.6A8 8 0 1 1 21 12Z"/>
    {%- when 'lock' -%}
      <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
    {%- when 'star' -%}
      <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3l-5.5 2.9 1-6.2L3 9.6l6.2-.9L12 3Z"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-9.2-9.3C1.6 7.4 3.7 4 7.2 4c2 0 3.6 1.1 4.8 2.8C13.2 5.1 14.8 4 16.8 4c3.5 0 5.6 3.4 4.4 6.7C19.5 15.4 12 20 12 20Z"/>
    {%- when 'compare' -%}
      <path d="M7 4 3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7"/>
    {%- when 'check' -%}
      <path d="m5 12 5 5L20 7"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
    {%- when 'map-pin' -%}
      <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>

    {%- comment -%} ---------- Customer accounts (popup, account pages) ---------- {%- endcomment -%}
    {%- when 'logout' -%}
      <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l-5-5 5-5M5 12h11"/>
    {%- when 'edit' -%}
      <path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4ZM13.5 6.5l4 4"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'bolt' -%}
      <path d="M13 3 4 14h7l-1 7 9-11h-7l1-7Z"/>
    {%- when 'arrow-left' -%}
      <path d="M19 12H5M11 18l-6-6 6-6"/>

    {%- comment -%} ---------- Product page ---------- {%- endcomment -%}
    {%- when 'ruler' -%}
      <path d="M3 15 15 3l6 6L9 21l-6-6Z"/><path d="m7 11 2 2M10 8l2 2M13 5l2 2"/>
    {%- when 'zoom' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M11 8v6M8 11h6"/>
    {%- when 'chevron-up' -%}
      <path d="m6 15 6-6 6 6"/>

    {%- comment -%} ---------- Blog ---------- {%- endcomment -%}
    {%- when 'calendar' -%}
      <rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'link' -%}
      <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>

    {%- comment -%} ---------- Cart page tools ---------- {%- endcomment -%}
    {%- when 'tag' -%}
      <path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9-9-9Z"/><circle cx="7.5" cy="7.5" r="1.5"/>

    {%- comment -%}
      ---------- Social media (footer) ----------
      Brand marks are filled shapes: fill="currentColor" stroke="none" on
      each shape overrides the outline style of the svg tag above.
    {%- endcomment -%}
    {%- when 'facebook' -%}
      <path fill="currentColor" stroke="none" d="M13.5 21v-7.5h2.5l.4-3H13.5V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3Z"/>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle fill="currentColor" stroke="none" cx="17.2" cy="6.8" r="1.1"/>
    {%- when 'pinterest' -%}
      <path fill="currentColor" stroke="none" d="M12.2 2.5c-5.3 0-8 3.8-8 7 0 1.9.7 3.6 2.3 4.3.3.1.5 0 .6-.3l.2-.9c.1-.3 0-.4-.2-.7-.5-.6-.8-1.3-.8-2.4 0-3.1 2.3-5.8 6-5.8 3.3 0 5.1 2 5.1 4.7 0 3.5-1.6 6.5-3.9 6.5-1.3 0-2.2-1-1.9-2.3.4-1.5 1.1-3.2 1.1-4.3 0-1-.5-1.8-1.6-1.8-1.3 0-2.3 1.3-2.3 3.1 0 1.1.4 1.9.4 1.9l-1.5 6.5c-.4 1.9-.1 4.3 0 4.5.1.1.2.2.3 0 .1-.2 1.6-2 2.1-3.8l.8-3.2c.4.8 1.6 1.4 2.9 1.4 3.8 0 6.4-3.5 6.4-8.1 0-3.5-3-6.8-7.5-6.8Z"/>
    {%- when 'youtube' -%}
      <path fill="currentColor" stroke="none" d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15V9l5.2 3L10 15Z"/>
    {%- when 'tiktok' -%}
      <path fill="currentColor" stroke="none" d="M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 0 1-2.6 2.5 2.6 2.6 0 0 1-2.6-2.6 2.6 2.6 0 0 1 3.4-2.5V9.6a5.7 5.7 0 0 0-6.5 5.7 5.7 5.7 0 0 0 5.7 5.7 5.7 5.7 0 0 0 5.7-5.7V9a7.3 7.3 0 0 0 4.3 1.4V7.3s-1.9.1-3.2-1.5Z"/>
    {%- when 'x' -%}
      <path fill="currentColor" stroke="none" d="M17.8 3h3.1l-6.8 7.8 8 10.2h-6.3l-4.9-6.4L5.3 21H2.2l7.3-8.3L1.8 3h6.4l4.4 5.9L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.5l11.2 14.5Z"/>
  {%- endcase -%}
</svg>
