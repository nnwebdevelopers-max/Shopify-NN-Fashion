{%- comment -%} Article image, or an illustration chosen from the article tags. Params: article, width {%- endcomment -%}
{%- if article.image -%}
  {{ article.image | image_url: width: width | image_tag: loading: 'lazy', widths: '400,600,800,1200,1600', sizes: '(min-width: 990px) 50vw, 90vw', alt: article.image.alt | default: article.title }}
{%- else -%}
  {%- assign t = article.tags | join: ' ' | append: ' ' | append: article.title -%}
  {%- capture k %}{% render 'art-for', text: t %}{% endcapture -%}
  {%- render 'art', name: k -%}
{%- endif -%}
