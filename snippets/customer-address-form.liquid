{%- comment -%}
  ============================================================================
  Snippet: Customer address form (fields of one add / edit address form)
  ----------------------------------------------------------------------------
  The inside of a Shopify "customer_address" form, used for "Add new address"
  and for each "Edit" on the addresses page:

      ┌ First name ────┐ ┌ Last name ─────┐
      ┌ Company (optional) ───────────────┐
      ┌ Address ──────────────────────────┐
      ┌ Apartment, suite, etc. ───────────┐
      ┌ City ──────────┐ ┌ Postal code ───┐
      ┌ Country ▾ ─────┐ ┌ State ▾ ───────┐   ← state only for countries that have them
      ┌ Phone ────────────────────────────┐
      ☐ Use as my default address
      [ SAVE ADDRESS ]  Cancel

  Country / state lists: Shopify's all_country_option_tags; the state list
  follows the chosen country with Shopify.CountryProvinceSelector
  (shopify_common.js, set up in assets/customer.js via [data-address-country]).

  Parameters:
  - form  {Form}  the form object of the surrounding {% form 'customer_address' %}
                  (form.id is "new" for the add form, the address id otherwise)

  Used in:  sections/customer-addresses.liquid
  CSS:      assets/global-account.css (fields), assets/customer.css → "Address dialogs"
  JS:       assets/customer.js (country → states, dialogs)
  Text:     locales → customer.fields.*, customer.addresses.*
  ============================================================================
{%- endcomment -%}

{%- liquid
  # Unique ids per form, e.g. "AddressCity_new", "AddressCity_8123"
  assign suffix = '_' | append: form.id
  assign id_first = 'AddressFirstName' | append: suffix
  assign id_last = 'AddressLastName' | append: suffix
  assign id_company = 'AddressCompany' | append: suffix
  assign id_address1 = 'AddressAddress1' | append: suffix
  assign id_address2 = 'AddressAddress2' | append: suffix
  assign id_city = 'AddressCity' | append: suffix
  assign id_zip = 'AddressZip' | append: suffix
  assign id_country = 'AddressCountry' | append: suffix
  assign id_province = 'AddressProvince' | append: suffix
  assign id_province_wrap = 'AddressProvinceWrap' | append: suffix
  assign id_phone = 'AddressPhone' | append: suffix
  assign id_default = 'AddressDefault' | append: suffix

  # Labels (render arguments can't use filters)
  assign optional = 'customer.fields.optional' | t
  assign label_first = 'customer.fields.first_name' | t
  assign label_last = 'customer.fields.last_name' | t
  assign label_company = 'customer.fields.company' | t | append: ' ' | append: optional
  assign label_address1 = 'customer.fields.address1' | t
  assign label_address2 = 'customer.fields.address2' | t
  assign label_city = 'customer.fields.city' | t
  assign label_zip = 'customer.fields.zip' | t
  assign label_phone = 'customer.fields.phone' | t | append: ' ' | append: optional
-%}

{%- if form.errors -%}
  <div class="account-form__errors" role="alert">
    <p>{{ 'customer.errors_title' | t }}</p>
    {{ form.errors | default_errors }}
  </div>
{%- endif -%}

<div class="account-form__row">
  {% render 'global-account-field', id: id_first, name: 'address[first_name]', label: label_first, value: form.first_name, autocomplete: 'given-name' %}
  {% render 'global-account-field', id: id_last, name: 'address[last_name]', label: label_last, value: form.last_name, autocomplete: 'family-name' %}
</div>
{% render 'global-account-field', id: id_company, name: 'address[company]', label: label_company, value: form.company, autocomplete: 'organization' %}
{% render 'global-account-field', id: id_address1, name: 'address[address1]', label: label_address1, value: form.address1, autocomplete: 'address-line1' %}
{% render 'global-account-field', id: id_address2, name: 'address[address2]', label: label_address2, value: form.address2, autocomplete: 'address-line2' %}
<div class="account-form__row">
  {% render 'global-account-field', id: id_city, name: 'address[city]', label: label_city, value: form.city, autocomplete: 'address-level2' %}
  {% render 'global-account-field', id: id_zip, name: 'address[zip]', label: label_zip, value: form.zip, autocomplete: 'postal-code' %}
</div>

{%- comment -%} Country + state (state list hidden for countries without states) {%- endcomment -%}
<div class="account-form__row">
  <div class="account-field account-field--select">
    <select
      class="account-field__input"
      id="{{ id_country }}"
      name="address[country]"
      autocomplete="country"
      data-address-country
      data-province-id="{{ id_province }}"
      data-province-wrap="{{ id_province_wrap }}"
      data-default="{{ form.country | escape }}"
    >
      {{ all_country_option_tags }}
    </select>
    <label class="account-field__label" for="{{ id_country }}">{{ 'customer.fields.country' | t }}</label>
  </div>
  <div class="account-field account-field--select" id="{{ id_province_wrap }}">
    <select
      class="account-field__input"
      id="{{ id_province }}"
      name="address[province]"
      autocomplete="address-level1"
      data-default="{{ form.province | escape }}"
    ></select>
    <label class="account-field__label" for="{{ id_province }}">{{ 'customer.fields.province' | t }}</label>
  </div>
</div>

{% render 'global-account-field', id: id_phone, name: 'address[phone]', type: 'tel', label: label_phone, value: form.phone, autocomplete: 'tel' %}

<label class="account-form__check" for="{{ id_default }}">
  <input type="checkbox" id="{{ id_default }}" name="address[default]" value="1" {% if form.set_as_default_checkbox contains 'checked' %}checked{% endif %}>
  <span class="account-form__checkmark" aria-hidden="true">{% render 'global-icon', name: 'check', size: 14 %}</span>
  <span>{{ 'customer.addresses.set_default' | t }}</span>
</label>

<div class="customer-dialog__actions">
  <button type="submit" class="button button--lg button--full account-form__submit">
    <span>{{ 'customer.addresses.save' | t }}</span>
    {% render 'global-icon', name: 'check', size: 18 %}
  </button>
  <button type="button" class="button button--outline button--lg account-form__secondary" data-dialog-close>{{ 'customer.addresses.cancel' | t }}</button>
</div>
