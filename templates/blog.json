/*
 * ============================================================================
 * Template: Blog (blog.json) — /blogs/<handle>, e.g. /blogs/news
 * ----------------------------------------------------------------------------
 * Sections:
 *   main → sections/blog-main.liquid (title, topics, featured post, cards,
 *          pagination; GSAP scroll effects shared with About / Contact)
 * Posts are written in Shopify admin > Online Store > Blog posts.
 * While the blog is empty, "Show sample posts" shows example cards.
 *
 * Note: Shopify replaces this comment with its own when the template is
 * saved from the theme editor.
 * ============================================================================
 */
{
  "sections": {
    "main": {
      "type": "blog-main",
      "settings": {
        "intro": "<p>Stories, outfit ideas and care tips from our studio.</p>",
        "show_tags": true,
        "show_featured": true,
        "per_page": 10,
        "columns": "3",
        "image_ratio": "4 / 3",
        "show_excerpt": true,
        "show_date": true,
        "show_reading_time": true,
        "show_samples": true,
        "serif": true,
        "background_color": "#F6F3EC",
        "text_color": "#2F3A2F",
        "accent_color": "#B8734F"
      }
    }
  },
  "order": ["main"]
}
