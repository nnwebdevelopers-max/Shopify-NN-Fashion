/*
 * ============================================================================
 * Template: Wishlist page (page.wishlist.json)
 * ----------------------------------------------------------------------------
 * Assign it to a page in Shopify admin: Online Store > Pages > Add page
 * (title "Wishlist") > Theme template: "wishlist". Then pick that page in
 * Theme editor > Header > Wishlist page (adds the ♡ icon with a count).
 *
 * Sections:
 *   main → sections/wishlist-main.liquid (saved products grid)
 *
 * Note: Shopify replaces this comment with its own when the template is
 * saved from the theme editor.
 * ============================================================================
 */
{
  "sections": {
    "main": {
      "type": "wishlist-main",
      "settings": {
        "columns_desktop": 4,
        "columns_mobile": "2",
        "image_ratio": "portrait"
      }
    }
  },
  "order": ["main"]
}
