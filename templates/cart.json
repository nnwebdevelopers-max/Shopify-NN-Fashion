/*
 * ============================================================================
 * Template: Cart page (cart.json)
 * ----------------------------------------------------------------------------
 * URL: /cart
 * Sections:
 *   main → sections/cart-main.liquid (items, quantities, subtotal, checkout)
 *
 * Note: Shopify replaces this comment with its own when the template is
 * saved from the theme editor.
 * ============================================================================
 */
{
  "sections": {
    "main": {
      "type": "cart-main",
      "settings": {
        "show_note": true,
        "show_express_checkout": true
      }
    }
  },
  "order": ["main"]
}
